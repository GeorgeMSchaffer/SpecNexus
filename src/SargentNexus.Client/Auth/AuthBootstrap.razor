@implements IDisposable
@inject IAuthSessionService AuthSessionService
@inject NavigationManager NavigationManager

@code {
    private static readonly string[] PublicRoutes = { "login", "register", "logout" };

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;

        await AuthSessionService.InitializeAsync();
        EnforceRouteAccess(redirectAuthenticatedAwayFromLogin: true);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        EnforceRouteAccess(redirectAuthenticatedAwayFromLogin: false);
    }

    private void EnforceRouteAccess(bool redirectAuthenticatedAwayFromLogin)
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var path = relative.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        var isPublicRoute = PublicRoutes.Contains(path);

        if (!AuthSessionService.IsAuthenticated)
        {
            if (!isPublicRoute)
            {
                NavigationManager.NavigateTo("/login", forceLoad: false);
            }

            return;
        }

        if (AuthSessionService.RequiresPasswordChange && path != "change-password" && path != "logout")
        {
            NavigationManager.NavigateTo("/change-password", forceLoad: false);
            return;
        }

        if (redirectAuthenticatedAwayFromLogin && path is "" or "login")
        {
            NavigationManager.NavigateTo("/workflow", forceLoad: false);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
