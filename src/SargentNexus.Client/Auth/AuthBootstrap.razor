@inject IAuthSessionService AuthSessionService
@inject NavigationManager NavigationManager

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthSessionService.InitializeAsync();

        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var path = relative.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        var isPublicRoute = path is "login" or "register";

        if (!AuthSessionService.IsAuthenticated)
        {
            if (!isPublicRoute)
            {
                NavigationManager.NavigateTo("/login", forceLoad: false);
            }

            return;
        }

        if (AuthSessionService.RequiresPasswordChange && path != "change-password")
        {
            NavigationManager.NavigateTo("/change-password", forceLoad: false);
            return;
        }

        if (path is "" or "login")
        {
            NavigationManager.NavigateTo("/workflow", forceLoad: false);
        }
    }
}
