<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SargentNexus</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (AuthSessionService.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="workflow">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Workflow
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ideas">
                    <span class="bi bi-lightbulb-fill-nav-menu" aria-hidden="true"></span> Ideas
                </NavLink>
            </div>
            @if (CanAccessSettings)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="settings">
                        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Settings
                    </NavLink>
                </div>
            }
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="change-password">
                    <span class="bi bi-key-fill-nav-menu" aria-hidden="true"></span> Change Password
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <button type="button" class="nav-link btn btn-link" @onclick="HandleLogoutAsync">
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Sign Out
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Sign In
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Inject]
    private IAuthSessionService AuthSessionService { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private bool CanAccessSettings =>
        string.Equals(AuthSessionService.User?.Role, "SiteAdmin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSessionService.User?.Role, "OrgAdmin", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        AuthSessionService.StateChanged += HandleAuthStateChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task HandleLogoutAsync()
    {
        await AuthSessionService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    private void HandleAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
