@inherits LayoutComponentBase
@inject IAuthSessionService AuthSessionService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span></span>
            <div class="d-flex align-items-center gap-3">
                @if (AuthSessionService.IsAuthenticated)
                {
                    <span class="text-white fw-semibold">@DisplayName</span>
                    @if (AuthSessionService.RequiresPasswordChange)
                    {
                        <span class="text-warning fw-semibold small">Password update required</span>
                    }
                    <a href="/settings" class="text-white" title="Settings" style="font-size:1.1rem; line-height:1;">⚙</a>
                }
                else
                {
                    <a href="/login" class="text-white">Sign in</a>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthSessionService.StateChanged += HandleAuthStateChanged;
    }

    private string DisplayName =>
        AuthSessionService.User is null
            ? "Authenticated user"
            : string.IsNullOrWhiteSpace($"{AuthSessionService.User.FirstName} {AuthSessionService.User.LastName}".Trim())
                ? AuthSessionService.User.Email
                : $"{AuthSessionService.User.FirstName} {AuthSessionService.User.LastName}".Trim();

    private void HandleAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
