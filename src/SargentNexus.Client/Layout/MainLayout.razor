@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span>@DisplayName</span>
                    @if (AuthSessionService.RequiresPasswordChange)
                    {
                        <span class="text-danger fw-semibold">Password update required</span>
                    }
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    [Inject]
    private IAuthSessionService AuthSessionService { get; set; } = null!;

    private string DisplayName =>
        AuthSessionService.User is null
            ? "Authenticated user"
            : string.IsNullOrWhiteSpace($"{AuthSessionService.User.FirstName} {AuthSessionService.User.LastName}".Trim())
                ? AuthSessionService.User.Email
                : $"{AuthSessionService.User.FirstName} {AuthSessionService.User.LastName}".Trim();
}
