@inherits LayoutComponentBase
@inject IAuthSessionService AuthSessionService

<div class="sn-shell">
    <header class="sn-topbar">
        <div class="sn-topbar__left">
            <a class="sn-logo" href="/">
                <span class="sn-logo__mark">SN</span>
                <span class="sn-logo__text">SargentNexus</span>
            </a>

            @if (AuthSessionService.IsAuthenticated)
            {
                <nav class="sn-nav" aria-label="Primary navigation">
                    <NavLink class="sn-nav__link" href="/" Match="NavLinkMatch.All">Home</NavLink>
                    <NavLink class="sn-nav__link" href="/boards">Boards</NavLink>
                    <NavLink class="sn-nav__link" href="/ideas">Ideas</NavLink>
                </nav>
            }
        </div>

        <div class="sn-topbar__right">
            @if (AuthSessionService.IsAuthenticated)
            {
                @if (AuthSessionService.RequiresPasswordChange)
                {
                    <a href="/change-password" class="sn-warning-link">Password update required</a>
                }
                <div class="sn-user-meta">
                    <span class="sn-username">@DisplayName</span>
                </div>
                <a class="sn-icon-button" href="/settings" title="Settings" aria-label="Settings">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"/>
                    </svg>
                </a>
                <a class="sn-icon-button" href="/logout" title="Sign out" aria-label="Sign out">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                    </svg>
                </a>
            }
            else
            {
                <a href="/login" class="btn btn-primary btn-sm">Sign in</a>
            }
        </div>
    </header>

    <main class="sn-main">
        <article class="content sn-content">
            @Body
        </article>
    </main>
</div>

@code {
    private string DisplayRole =>
        string.IsNullOrWhiteSpace(AuthSessionService.User?.Role)
            ? "User"
            : AuthSessionService.User!.Role;

    private string DisplayName =>
        AuthSessionService.User is null
            ? "Authenticated user"
            : string.IsNullOrWhiteSpace($"{AuthSessionService.User.FirstName} {AuthSessionService.User.LastName}".Trim())
                ? AuthSessionService.User.Email
                : $"{AuthSessionService.User.FirstName} {AuthSessionService.User.LastName}".Trim();

    protected override void OnInitialized()
    {
        AuthSessionService.StateChanged += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}

