@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthSessionService AuthSessionService
@inject NavigationManager NavigationManager

<div class="sn-shell">
    <header class="sn-topbar">
        <div class="sn-topbar__inner">
            <a class="sn-logo" href="/" aria-label="SargentNexus home">
                <span class="sn-logo__mark">SN</span>
                <span class="sn-logo__text">SargentNexus</span>
            </a>

            <div class="sn-topbar__actions">
                @if (AuthSessionService.IsAuthenticated)
                {
                    @if (AuthSessionService.RequiresPasswordChange)
                    {
                        <a href="/change-password" class="sn-warning-link">Password update required</a>
                    }
                    <a class="sn-icon-button" href="/settings" title="Settings" aria-label="Settings">
                        <i class="bi bi-gear-fill"></i>
                    </a>
                    <button class="sn-icon-button" type="button" title="Sign out" aria-label="Sign out" @onclick="HandleLogoutAsync">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                    <span class="sn-username">@DisplayName</span>
                }
                else
                {
                    <a href="/login" class="sn-auth-link">Login</a>
                    <a href="/register" class="sn-auth-link">Register</a>
                }
            </div>
        </div>
    </header>

    @if (AuthSessionService.IsAuthenticated)
    {
        <nav class="sn-menu" aria-label="Primary navigation">
            <div class="sn-menu__inner">
                <NavLink class="sn-menu__link" href="/" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink class="sn-menu__link" href="/workflow">Workflows</NavLink>
                <NavLink class="sn-menu__link" href="/ideas">Ideas</NavLink>
            </div>
        </nav>
    }

    <main class="sn-main">
        <article class="content sn-content">
            @Body
        </article>
    </main>
</div>

@code {
    private string DisplayName =>
        AuthSessionService.User is { } user
            ? string.IsNullOrWhiteSpace($"{user.FirstName} {user.LastName}".Trim())
                ? user.Email
                : $"{user.FirstName} {user.LastName}".Trim()
            : "Authenticated user";

    protected override void OnInitialized()
    {
        AuthSessionService.StateChanged += HandleAuthStateChanged;
    }

    public void Dispose()
    {
        AuthSessionService.StateChanged -= HandleAuthStateChanged;
    }

    private async Task HandleLogoutAsync()
    {
        await AuthSessionService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    private void HandleAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
