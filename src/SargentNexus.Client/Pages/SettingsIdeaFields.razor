@page "/settings/organizations/{OrganizationId:guid}/idea-fields"
@inject IAuthSessionService AuthSessionService

<PageTitle>Idea Fields - Settings</PageTitle>

<AuthGate>
    <div class="container py-4 sn-page sn-settings-page">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Idea Fields</h1>
                <p class="text-muted mb-0">Manage the options used to classify ideas.</p>
            </div>
            <NavLink class="btn btn-sm btn-outline-secondary" href="@BackLink">← Back</NavLink>
        </div>

        @if (!CanManageTargetOrganization)
        {
            <div class="alert alert-warning" role="alert">You do not have permission to manage idea fields for this organization.</div>
        }
        else if (string.IsNullOrWhiteSpace(AuthSessionService.AccessToken))
        {
            <div class="alert alert-warning" role="alert">Your authenticated session is unavailable.</div>
        }
        else
        {
            <IdeaTypeSettingsSection OrganizationId="OrganizationId" AccessToken="AuthSessionService.AccessToken!" />
            <BusinessImpactSettingsSection OrganizationId="OrganizationId" AccessToken="AuthSessionService.AccessToken!" />
        }
    </div>
</AuthGate>

@code {
    [Parameter]
    public Guid OrganizationId { get; set; }

    private bool IsSiteAdmin => string.Equals(AuthSessionService.User?.Role, "SiteAdmin", StringComparison.OrdinalIgnoreCase);
    private bool IsOrgAdmin => string.Equals(AuthSessionService.User?.Role, "OrgAdmin", StringComparison.OrdinalIgnoreCase);
    private bool CanManageTargetOrganization =>
        IsSiteAdmin ||
        (IsOrgAdmin && AuthSessionService.User?.OrganizationId == OrganizationId);

    private string BackLink => IsSiteAdmin ? "/settings/organizations" : "/settings";
}