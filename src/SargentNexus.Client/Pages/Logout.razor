@page "/logout"
@inject IAuthSessionService AuthSessionService
@inject NavigationManager NavigationManager

<PageTitle>Signing out</PageTitle>

<p>Signing out...</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthSessionService.LogoutAsync();

        // Full reload so no stale in-memory auth state (e.g. a concurrent
        // InitializeAsync that read the token before it was cleared) survives.
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
