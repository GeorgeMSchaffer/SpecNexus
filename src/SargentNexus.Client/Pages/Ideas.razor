@if (_showCreateDialog)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(15,23,42,.35);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5 mb-0">New Idea</h2>
                    <button type="button" class="btn-close" @onclick="CloseCreateDialog" disabled="@_isSubmitting"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_createModel" OnValidSubmit="HandleCreateAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <InputText class="form-control" @bind-Value="_createModel.Title" />
                            <ValidationMessage For="() => _createModel.Title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_createModel.Description" />
                            <ValidationMessage For="() => _createModel.Description" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Priority</label>
                                <InputSelect class="form-select" @bind-Value="_createModel.Priority">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Due date</label>
                                <InputDate class="form-control" @bind-Value="_createModel.DueDate" />
                            </div>
                        </div>

                        <div class="mt-3 mb-3">
                            <label class="form-label">Tags</label>
                            <InputText class="form-control" @bind-Value="_createModel.TagText" placeholder="comma separated tags" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-secondary" type="button" @onclick="CloseCreateDialog" disabled="@_isSubmitting">Cancel</button>
                            <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">@(_isSubmitting ? "Saving..." : "Save Idea")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (_showIdeaPanel)
{
    <div class="ideas-page__overlay-backdrop" @onclick="CloseIdeaPanel"></div>
    <aside class="ideas-page__overlay-panel" aria-label="Idea detail panel">
        <div class="ideas-page__overlay-header">
            <div>
                <h2 class="ideas-page__overlay-title">Idea Details</h2>
                <p class="ideas-page__overlay-subtitle">Opened in context from the board title link.</p>
            </div>
            <button type="button" class="btn-close" @onclick="CloseIdeaPanel"></button>
        </div>

        @if (_loadingIdeaPanel)
        {
            <div class="alert alert-info">Loading idea details…</div>
        }
        else if (_ideaPanelErrorMessage is not null)
        {
            <div class="alert alert-danger">@_ideaPanelErrorMessage</div>
        }
        else if (_selectedIdeaDetail is not null)
        {
            <div class="ideas-page__overlay-grid">
                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Title</span>
                    <div class="ideas-page__overlay-value fw-semibold">@_selectedIdeaDetail.Title</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Priority</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.Priority</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Status</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.StatusName</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Assigned To</span>
                    <div class="ideas-page__overlay-value">@(_selectedIdeaDetail.AssigneeDisplayName ?? "Unassigned")</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Upvotes</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.UpvoteCount</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Due Date</span>
                    <div class="ideas-page__overlay-value">@(_selectedIdeaDetail.DueDate?.ToString("d") ?? "None")</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Mentions</span>
                    <div class="ideas-page__overlay-value">
                        @if (_selectedIdeaDetail.Mentions.Count == 0)
                        {
                            <span>None</span>
                        }
                        else
                        {
                            @string.Join(", ", _selectedIdeaDetail.Mentions)
                        }
                    </div>
                </div>

                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Description</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.Description</div>
                </div>

                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Tags</span>
                    @if (_selectedIdeaDetail.TagNames.Count == 0)
                    {
                        <div class="ideas-page__overlay-value">No tags</div>
                    }
                    else
                    {
                        <div class="ideas-page__overlay-tags">
                            @foreach (var tag in _selectedIdeaDetail.TagNames)
                            {
                                <span class="ideas-page__overlay-tag">@tag</span>
                            }
                        </div>
                    }
                </div>

                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Comments</span>
                    @if (_selectedIdeaDetail.Comments.Count == 0)
                    {
                        <div class="ideas-page__overlay-value">No comments yet.</div>
                    }
                    else
                    {
                        <div class="ideas-page__overlay-comments">
                            @foreach (var comment in _selectedIdeaDetail.Comments)
                            {
                                <div class="ideas-page__overlay-comment">
                                    <div class="ideas-page__overlay-comment-meta">@comment.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                                    <div>@comment.Body</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="ideas-page__overlay-actions">
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseIdeaPanel">Close</button>
                <button class="btn btn-primary" type="button" @onclick="OpenIdeaPage">Open full edit page</button>
            </div>
        }
    </aside>
}

