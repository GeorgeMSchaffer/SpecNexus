@page "/ideas"
@inject IAuthSessionService AuthSessionService
@inject IClientErrorMessageService ErrorMessageService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject WorkflowApiClient WorkflowApiClient

<PageTitle>Ideas</PageTitle>

<AuthGate>
    <div class="container-fluid py-4 ideas-page">
        <div class="ideas-page__header">
            <div>
                <h1 class="h3 mb-1">Ideas</h1>
                <p class="text-muted mb-0">Compact board overview for the selected workflow board.</p>
            </div>

            @if (_boards.Count > 0)
            {
                <div class="ideas-page__header-actions">
                    <div class="ideas-page__board-picker">
                        <label class="form-label small text-muted mb-1" for="ideas-board-picker">Board</label>
                        <select id="ideas-board-picker" class="form-select" value="@SelectedBoardIdText" @onchange="HandleBoardChangeAsync">
                            @foreach (var board in _boards)
                            {
                                <option value="@board.BoardId">@board.Name</option>
                            }
                        </select>
                    </div>

                    <div class="ideas-page__header-search">
                        <label class="visually-hidden" for="ideas-search">Search ideas</label>
                        <input id="ideas-search"
                               class="form-control"
                               type="search"
                               placeholder="Search title, tag, assignee"
                               @bind="_search"
                               @bind:event="oninput" />
                    </div>

                    @if (CanCreateIdeas)
                    {
                        <button class="btn btn-primary" @onclick="OpenCreateDialog" disabled="@(_selectedBoard is null)">New Idea</button>
                    }
                </div>
            }
        </div>

        @if (_loading)
        {
            <div class="alert alert-info">Loading ideas board…</div>
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger alert-dismissible d-flex align-items-start gap-2" role="alert">
                <span>@_errorMessage</span>
                <button type="button" class="btn-close ms-auto" @onclick="DismissError" aria-label="Close"></button>
            </div>
        }
        else if (_boards.Count == 0)
        {
            <div class="alert alert-secondary">No boards are available for your organization yet.</div>
        }
        else if (_selectedBoard is null)
        {
            <div class="alert alert-secondary">Select a board to view its ideas.</div>
        }
        else
        {
            <div class="ideas-page__toolbar">
                <div class="ideas-page__filters" role="group" aria-label="Idea filters">
                    <button class="@GetFilterButtonClass(IdeaFilter.All)" @onclick="() => SetFilter(IdeaFilter.All)">All</button>
                    <button class="@GetFilterButtonClass(IdeaFilter.CreatedByMe)" @onclick="() => SetFilter(IdeaFilter.CreatedByMe)">Created by me</button>
                    <button class="@GetFilterButtonClass(IdeaFilter.AssignedToMe)" @onclick="() => SetFilter(IdeaFilter.AssignedToMe)">Assigned to me</button>
                </div>
            </div>

            <div class="ideas-page__board-shell">
                @if (_loadingBoardIdeas)
                {
                    <div class="alert alert-info">Loading board ideas…</div>
                }
                else
                {
                    <IdeaKanbanBoard Columns="VisibleColumns"
                                     CanReorderColumns="CanReorderColumns"
                                     OnCardSelected="OpenIdeaPanelAsync"
                                     OnIdeaMoved="HandleIdeaMovedAsync"
                                     OnColumnsReordered="HandleColumnsReorderedAsync" />
                }
            </div>
        }
    </div>
</AuthGate>

@if (_showCreateDialog)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(15,23,42,.35);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5 mb-0">New Idea</h2>
                    <button type="button" class="btn-close" @onclick="CloseCreateDialog" disabled="@_isSubmitting"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_createModel" OnValidSubmit="HandleCreateAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <InputText class="form-control" @bind-Value="_createModel.Title" />
                            <ValidationMessage For="() => _createModel.Title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_createModel.Description" />
                            <ValidationMessage For="() => _createModel.Description" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Priority</label>
                                <InputSelect class="form-select" @bind-Value="_createModel.Priority">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Due date</label>
                                <InputDate class="form-control" @bind-Value="_createModel.DueDate" />
                            </div>
                        </div>

                        <div class="mt-3 mb-3">
                            <label class="form-label">Tags</label>
                            <InputText class="form-control" @bind-Value="_createModel.TagText" placeholder="comma separated tags" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-secondary" type="button" @onclick="CloseCreateDialog" disabled="@_isSubmitting">Cancel</button>
                            <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">@(_isSubmitting ? "Saving..." : "Save Idea")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (_showIdeaPanel)
{
    <div class="ideas-page__overlay-backdrop" @onclick="CloseIdeaPanel"></div>
    <aside class="ideas-page__overlay-panel" aria-label="Idea detail panel">
        <div class="ideas-page__overlay-header">
            <div>
                <h2 class="ideas-page__overlay-title">Idea Details</h2>
                <p class="ideas-page__overlay-subtitle">Opened in context from the board title link.</p>
            </div>
            <button type="button" class="btn-close" @onclick="CloseIdeaPanel"></button>
        </div>

        @if (_loadingIdeaPanel)
        {
            <div class="alert alert-info">Loading idea details…</div>
        }
        else if (_ideaPanelErrorMessage is not null)
        {
            <div class="alert alert-danger">@_ideaPanelErrorMessage</div>
        }
        else if (_selectedIdeaDetail is not null)
        {
            <div class="ideas-page__overlay-grid">
                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Title</span>
                    <div class="ideas-page__overlay-value fw-semibold">@_selectedIdeaDetail.Title</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Priority</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.Priority</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Status</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.StatusName</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Assigned To</span>
                    <div class="ideas-page__overlay-value">@(_selectedIdeaDetail.AssigneeDisplayName ?? "Unassigned")</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Upvotes</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.UpvoteCount</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Due Date</span>
                    <div class="ideas-page__overlay-value">@(_selectedIdeaDetail.DueDate?.ToString("d") ?? "None")</div>
                </div>

                <div class="ideas-page__overlay-field">
                    <span class="ideas-page__overlay-label">Mentions</span>
                    <div class="ideas-page__overlay-value">
                        @if (_selectedIdeaDetail.Mentions.Count == 0)
                        {
                            <span>None</span>
                        }
                        else
                        {
                            @string.Join(", ", _selectedIdeaDetail.Mentions)
                        }
                    </div>
                </div>

                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Description</span>
                    <div class="ideas-page__overlay-value">@_selectedIdeaDetail.Description</div>
                </div>

                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Tags</span>
                    @if (_selectedIdeaDetail.TagNames.Count == 0)
                    {
                        <div class="ideas-page__overlay-value">No tags</div>
                    }
                    else
                    {
                        <div class="ideas-page__overlay-tags">
                            @foreach (var tag in _selectedIdeaDetail.TagNames)
                            {
                                <span class="ideas-page__overlay-tag">@tag</span>
                            }
                        </div>
                    }
                </div>

                <div class="ideas-page__overlay-field ideas-page__overlay-field--full">
                    <span class="ideas-page__overlay-label">Comments</span>
                    @if (_selectedIdeaDetail.Comments.Count == 0)
                    {
                        <div class="ideas-page__overlay-value">No comments yet.</div>
                    }
                    else
                    {
                        <div class="ideas-page__overlay-comments">
                            @foreach (var comment in _selectedIdeaDetail.Comments)
                            {
                                <div class="ideas-page__overlay-comment">
                                    <div class="ideas-page__overlay-comment-meta">@comment.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                                    <div>@comment.Body</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="ideas-page__overlay-actions">
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseIdeaPanel">Close</button>
                <button class="btn btn-primary" type="button" @onclick="OpenIdeaPage">Open full edit page</button>
            </div>
        }
    </aside>
}

@code {
    private const string BoardStorageKey = "ideas-board-id";

    private static readonly string[] StatusColorPalette =
    [
        "#0f6cbd",
        "#4f46e5",
        "#7c3aed",
        "#be185d",
        "#c2410c",
        "#0f766e",
        "#2563eb",
        "#1d4ed8"
    ];

    private enum IdeaFilter
    {
        All,
        CreatedByMe,
        AssignedToMe
    }

    private readonly List<BoardSummaryDto> _boards = new();
    private IReadOnlyList<KanbanIdeaCardModel> _ideas = Array.Empty<KanbanIdeaCardModel>();
    private IdeaFilter _filter = IdeaFilter.All;
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _loadingBoardIdeas;
    private bool _loadingIdeaPanel;
    private bool _showCreateDialog;
    private bool _showIdeaPanel;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _ideaPanelErrorMessage;
    private BoardSummaryDto? _selectedBoard;
    private IdeaDetailDto? _selectedIdeaDetail;
    private CreateIdeaFormModel _createModel = new();

    private Guid? CurrentUserId => AuthSessionService.User?.UserId;
    private string? CurrentUserRole => AuthSessionService.User?.Role;
    private bool CanReorderColumns => CurrentUserRole is "SiteAdmin" or "OrgAdmin";
    private bool CanCreateIdeas => !string.Equals(CurrentUserRole, "ReadOnly", StringComparison.OrdinalIgnoreCase);

    private string SelectedBoardIdText => _selectedBoard?.BoardId.ToString() ?? string.Empty;

    private IReadOnlyList<KanbanColumnModel> VisibleColumns
    {
        get
        {
            if (_selectedBoard is null)
            {
                return Array.Empty<KanbanColumnModel>();
            }

            var cardsByStatus = FilteredIdeas
                .GroupBy(card => card.StatusId)
                .ToDictionary(group => group.Key, group => (IReadOnlyList<KanbanIdeaCardModel>)group.ToArray());

            return _selectedBoard.Swimlanes
                .OrderBy(swimlane => swimlane.Order)
                .Select(swimlane => new KanbanColumnModel
                {
                    StatusId = swimlane.StatusId,
                    StatusName = swimlane.StatusName,
                    StatusColor = GetStatusColor(swimlane.StatusId),
                    IsDeletedStatus = swimlane.IsDeletedStatus,
                    Order = swimlane.Order,
                    Cards = cardsByStatus.TryGetValue(swimlane.StatusId, out var cards) ? cards : Array.Empty<KanbanIdeaCardModel>()
                })
                .ToArray();
        }
    }

    private IEnumerable<KanbanIdeaCardModel> FilteredIdeas
    {
        get
        {
            IEnumerable<KanbanIdeaCardModel> ideas = _ideas;
            var userId = CurrentUserId;

            if (_filter == IdeaFilter.CreatedByMe && userId.HasValue)
            {
                ideas = ideas.Where(idea => idea.AuthorUserId == userId.Value);
            }
            else if (_filter == IdeaFilter.AssignedToMe && userId.HasValue)
            {
                ideas = ideas.Where(idea => idea.AssigneeUserId == userId.Value);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                ideas = ideas.Where(idea => MatchesSearch(idea, term));
            }

            return ideas;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            if (!AuthSessionService.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var organizationId = AuthSessionService.User?.OrganizationId;
            if (organizationId is null || organizationId.Value == Guid.Empty)
            {
                _errorMessage = "Your account is not associated with an organization.";
                return;
            }

            var boards = await WorkflowApiClient.ListBoardsAsync(AuthSessionService.AccessToken!, organizationId.Value, CancellationToken.None);
            _boards.Clear();
            _boards.AddRange(boards);

            _selectedBoard = await ResolveSelectedBoardAsync();

            if (_selectedBoard is not null)
            {
                await PersistSelectedBoardAsync(_selectedBoard.BoardId);
                await LoadBoardIdeasAsync();
            }
            else
            {
                _ideas = Array.Empty<KanbanIdeaCardModel>();
                await ClearSelectedBoardAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<BoardSummaryDto?> ResolveSelectedBoardAsync()
    {
        if (_boards.Count == 0)
        {
            return null;
        }

        var storedBoardId = await ReadStoredBoardIdAsync();
        if (storedBoardId.HasValue)
        {
            var storedBoard = _boards.FirstOrDefault(board => board.BoardId == storedBoardId.Value);
            if (storedBoard is not null)
            {
                return storedBoard;
            }
        }

        return _boards[0];
    }

    private async Task LoadBoardIdeasAsync()
    {
        if (_selectedBoard is null)
        {
            _ideas = Array.Empty<KanbanIdeaCardModel>();
            return;
        }

        _loadingBoardIdeas = true;
        _errorMessage = null;

        try
        {
            var listItems = await WorkflowApiClient.ListAllIdeasForBoardAsync(
                AuthSessionService.AccessToken!,
                _selectedBoard.BoardId,
                CancellationToken.None);

            IReadOnlyDictionary<Guid, IdeaDetailDto> detailsById;
            if (listItems.Count == 0)
            {
                detailsById = new Dictionary<Guid, IdeaDetailDto>();
            }
            else
            {
                var detailTasks = listItems
                    .Select(item => WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, item.IdeaId, CancellationToken.None))
                    .ToArray();

                detailsById = (await Task.WhenAll(detailTasks))
                    .ToDictionary(detail => detail.IdeaId);
            }

            _ideas = listItems
                .Select(item =>
                {
                    detailsById.TryGetValue(item.IdeaId, out var detail);
                    return MapIdeaCard(item, detail);
                })
                .ToArray();
        }
        catch (Exception ex)
        {
            _ideas = Array.Empty<KanbanIdeaCardModel>();
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loadingBoardIdeas = false;
        }
    }

    private async Task HandleBoardChangeAsync(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var boardId))
        {
            return;
        }

        var selectedBoard = _boards.FirstOrDefault(board => board.BoardId == boardId);
        if (selectedBoard is null || selectedBoard.BoardId == _selectedBoard?.BoardId)
        {
            return;
        }

        _selectedBoard = selectedBoard;
        CloseIdeaPanel();
        await PersistSelectedBoardAsync(boardId);
        await LoadBoardIdeasAsync();
    }

    private async Task HandleIdeaMovedAsync((Guid ideaId, Guid targetStatusId) args)
    {
        var (ideaId, targetStatusId) = args;
        var originalIdea = _ideas.FirstOrDefault(idea => idea.IdeaId == ideaId);
        if (originalIdea is null || originalIdea.StatusId == targetStatusId)
        {
            return;
        }

        var targetColumn = VisibleColumns.FirstOrDefault(column => column.StatusId == targetStatusId);
        if (targetColumn is null)
        {
            return;
        }

        var previousStatusId = originalIdea.StatusId;

        _ideas = _ideas
            .Select(idea => idea.IdeaId == ideaId
                ? CopyIdea(idea, targetStatusId)
                : idea)
            .ToArray();

        if (_selectedIdeaDetail?.IdeaId == ideaId)
        {
            _selectedIdeaDetail.StatusId = targetStatusId;
            _selectedIdeaDetail.StatusName = targetColumn.StatusName;
        }

        try
        {
            await WorkflowApiClient.MoveIdeaStatusAsync(AuthSessionService.AccessToken!, ideaId, targetStatusId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _ideas = _ideas
                .Select(idea => idea.IdeaId == ideaId
                    ? CopyIdea(idea, previousStatusId)
                    : idea)
                .ToArray();

            if (_selectedIdeaDetail?.IdeaId == ideaId && _selectedBoard is not null)
            {
                var originalColumn = _selectedBoard.Swimlanes.FirstOrDefault(swimlane => swimlane.StatusId == previousStatusId);
                _selectedIdeaDetail.StatusId = previousStatusId;
                _selectedIdeaDetail.StatusName = originalColumn?.StatusName ?? _selectedIdeaDetail.StatusName;
            }

            _errorMessage = ErrorMessageService.GetDisplayMessage("Could not move idea.", null, ex);
        }
    }

    private async Task HandleColumnsReorderedAsync(IReadOnlyList<KanbanColumnModel> newOrder)
    {
        if (_selectedBoard is null)
        {
            return;
        }

        var originalSwimlanes = _selectedBoard.Swimlanes.ToList();
        var swimlaneLookup = originalSwimlanes.ToDictionary(swimlane => swimlane.StatusId);
        var reorderedSwimlanes = newOrder
            .Select((column, index) =>
            {
                var swimlane = swimlaneLookup[column.StatusId];
                return new SwimlaneDto
                {
                    StatusId = swimlane.StatusId,
                    StatusName = swimlane.StatusName,
                    IsDeletedStatus = swimlane.IsDeletedStatus,
                    Order = index + 1
                };
            })
            .ToList();

        _selectedBoard.Swimlanes = reorderedSwimlanes;

        try
        {
            await WorkflowApiClient.ReorderSwimlanesAsync(
                AuthSessionService.AccessToken!,
                _selectedBoard.BoardId,
                reorderedSwimlanes.Select(swimlane => swimlane.StatusId).ToArray(),
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _selectedBoard.Swimlanes = originalSwimlanes;
            _errorMessage = ErrorMessageService.GetDisplayMessage("Could not reorder columns.", null, ex);
        }
    }

    private void DismissError()
    {
        _errorMessage = null;
    }
    private void SetFilter(IdeaFilter filter)
    {
        _filter = filter;
    }

    private void OpenCreateDialog()
    {
        _showCreateDialog = true;
    }

    private void CloseCreateDialog()
    {
        if (_isSubmitting)
        {
            return;
        }

        _showCreateDialog = false;
    }

    private async Task HandleCreateAsync()
    {
        if (_selectedBoard is null)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var createdIdea = await WorkflowApiClient.CreateIdeaAsync(
                AuthSessionService.AccessToken!,
                _selectedBoard.BoardId,
                new IdeaWriteRequestDto
                {
                    Title = _createModel.Title.Trim(),
                    Description = _createModel.Description.Trim(),
                    Priority = _createModel.Priority,
                    DueDate = _createModel.DueDate,
                    TagNames = _createModel.TagText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                    MentionEmails = Array.Empty<string>()
                },
                CancellationToken.None);

            _createModel = new CreateIdeaFormModel();
            _showCreateDialog = false;
            await LoadBoardIdeasAsync();
            await OpenIdeaPanelAsync(createdIdea.IdeaId);
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenIdeaPanelAsync(Guid ideaId)
    {
        _showIdeaPanel = true;
        _loadingIdeaPanel = true;
        _ideaPanelErrorMessage = null;
        _selectedIdeaDetail = null;

        try
        {
            _selectedIdeaDetail = await WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, ideaId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _ideaPanelErrorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loadingIdeaPanel = false;
        }
    }

    private void CloseIdeaPanel()
    {
        _showIdeaPanel = false;
        _loadingIdeaPanel = false;
        _ideaPanelErrorMessage = null;
        _selectedIdeaDetail = null;
    }

    private void OpenIdeaPage()
    {
        if (_selectedIdeaDetail is null)
        {
            return;
        }

        NavigationManager.NavigateTo($"/ideas/{_selectedIdeaDetail.IdeaId}/edit");
    }

    private string GetFilterButtonClass(IdeaFilter filter)
    {
        return _filter == filter ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
    }

    private static bool MatchesSearch(KanbanIdeaCardModel idea, string term)
    {
        if (idea.Title.Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(idea.AssigneeDisplayName) &&
            idea.AssigneeDisplayName.Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return idea.TagNames.Any(tag => tag.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static KanbanIdeaCardModel MapIdeaCard(IdeaListItemDto item, IdeaDetailDto? detail)
    {
        return new KanbanIdeaCardModel
        {
            IdeaId = item.IdeaId,
            StatusId = item.StatusId,
            AuthorUserId = item.AuthorUserId,
            AssigneeUserId = item.AssigneeUserId,
            Title = item.Title,
            Priority = item.Priority,
            AssigneeDisplayName = item.AssigneeDisplayName,
            AssigneeInitials = GetInitials(item.AssigneeDisplayName),
            CreatedAtUtc = item.CreatedAtUtc,
            CreatedAtDisplay = GetRelativeCreatedAt(item.CreatedAtUtc),
            UpvoteCount = item.UpvoteCount,
            TagNames = detail?.TagNames ?? Array.Empty<string>()
        };
    }

    private static KanbanIdeaCardModel CopyIdea(KanbanIdeaCardModel idea, Guid statusId)
    {
        return new KanbanIdeaCardModel
        {
            IdeaId = idea.IdeaId,
            StatusId = statusId,
            AuthorUserId = idea.AuthorUserId,
            AssigneeUserId = idea.AssigneeUserId,
            Title = idea.Title,
            Priority = idea.Priority,
            AssigneeDisplayName = idea.AssigneeDisplayName,
            AssigneeInitials = idea.AssigneeInitials,
            CreatedAtUtc = idea.CreatedAtUtc,
            CreatedAtDisplay = idea.CreatedAtDisplay,
            UpvoteCount = idea.UpvoteCount,
            TagNames = idea.TagNames
        };
    }
    private static string GetInitials(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return "UA";
        }

        var parts = displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]))
            .ToArray();

        return parts.Length == 0 ? "UA" : new string(parts);
    }

    private static string GetRelativeCreatedAt(DateTime createdAtUtc)
    {
        var elapsed = DateTime.UtcNow - createdAtUtc;

        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "Just now";
        }

        if (elapsed < TimeSpan.FromHours(1))
        {
            var minutes = Math.Max(1, (int)Math.Floor(elapsed.TotalMinutes));
            return $"{minutes}m ago";
        }

        if (elapsed < TimeSpan.FromDays(1))
        {
            var hours = Math.Max(1, (int)Math.Floor(elapsed.TotalHours));
            return $"{hours}h ago";
        }

        if (elapsed < TimeSpan.FromDays(7))
        {
            var days = Math.Max(1, (int)Math.Floor(elapsed.TotalDays));
            return $"{days}d ago";
        }

        return createdAtUtc.ToLocalTime().ToString("d");
    }

    private static string GetStatusColor(Guid statusId)
    {
        var bytes = statusId.ToByteArray();
        return StatusColorPalette[bytes[0] % StatusColorPalette.Length];
    }

    private async Task<Guid?> ReadStoredBoardIdAsync()
    {
        var boardIdText = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", BoardStorageKey);
        return Guid.TryParse(boardIdText, out var boardId) ? boardId : null;
    }

    private async Task PersistSelectedBoardAsync(Guid boardId)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", BoardStorageKey, boardId.ToString());
    }

    private async Task ClearSelectedBoardAsync()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", BoardStorageKey);
    }

    private sealed class CreateIdeaFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(150)]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(4000)]
        public string Description { get; set; } = string.Empty;

        public string Priority { get; set; } = "Medium";

        public DateOnly? DueDate { get; set; }

        public string TagText { get; set; } = string.Empty;
    }
