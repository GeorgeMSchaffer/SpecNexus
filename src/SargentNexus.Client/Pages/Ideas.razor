    private async Task OpenCreatePanelAsync()
    {
        if (_selectedBoard is null)
        {
            return;
        }

        _showIdeaPanel = true;
        _loadingIdeaPanel = true;
        _ideaPanelErrorMessage = null;
        _selectedIdeaDetail = null;
        _overlayMode = IdeaOverlayMode.Create;

        try
        {
            await EnsureAssigneeOptionsLoadedAsync();
            _ideaForm = CreateEmptyIdeaForm();
        }
        catch (Exception ex)
        {
            _ideaPanelErrorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loadingIdeaPanel = false;
        }
    }

    private async Task HandleIdeaSaveAsync()
    {
        if (_selectedBoard is null)
        {
            return;
        }

        if (!TryCreateIdeaWriteRequest(out var request))
        {
            _ideaPanelErrorMessage = "Select a valid board status before saving.";
            return;
        }

        _isSubmitting = true;
        _ideaPanelErrorMessage = null;

        try
        {
            if (_overlayMode == IdeaOverlayMode.Create)
            {
                await WorkflowApiClient.CreateIdeaAsync(
                    AuthSessionService.AccessToken!,
                    _selectedBoard.BoardId,
                    request,
                    CancellationToken.None);
            }
            else if (_selectedIdeaDetail is not null)
            {
                _selectedIdeaDetail = await WorkflowApiClient.UpdateIdeaAsync(
                    AuthSessionService.AccessToken!,
                    _selectedIdeaDetail.IdeaId,
                    request,
                    CancellationToken.None);
            }

            await LoadBoardIdeasAsync();
            _isSubmitting = false;
            CloseIdeaPanel();
        }
        catch (Exception ex)
        {
            _ideaPanelErrorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleMoveIdeaFromOverlayAsync()
    {
        if (_selectedIdeaDetail is null || !Guid.TryParse(_ideaForm.StatusIdText, out var targetStatusId))
        {
            return;
        }

        _isSubmitting = true;
        _ideaPanelErrorMessage = null;

        try
        {
            await HandleIdeaMovedAsync((_selectedIdeaDetail.IdeaId, targetStatusId));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenIdeaPanelAsync(Guid ideaId)
    {
        _showIdeaPanel = true;
        _loadingIdeaPanel = true;
        _ideaPanelErrorMessage = null;
        _selectedIdeaDetail = null;
        _overlayMode = CanEditIdeas ? IdeaOverlayMode.Edit : IdeaOverlayMode.ReadOnly;

        try
        {
            if (_overlayMode == IdeaOverlayMode.Edit)
            {
                await EnsureAssigneeOptionsLoadedAsync();
            }

            _selectedIdeaDetail = await WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, ideaId, CancellationToken.None);

            if (_overlayMode == IdeaOverlayMode.Edit)
            {
                _ideaForm = CreateIdeaForm(_selectedIdeaDetail);
            }
        }
        catch (Exception ex)
        {
            _ideaPanelErrorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loadingIdeaPanel = false;
        }
    }

    private void CloseIdeaPanel()
    {
        if (_isSubmitting)
        {
            return;
        }

        _showIdeaPanel = false;
        _loadingIdeaPanel = false;
        _ideaPanelErrorMessage = null;
        _selectedIdeaDetail = null;
        _overlayMode = IdeaOverlayMode.ReadOnly;
        _ideaForm = new IdeaOverlayFormModel
        {
            Priority = "Medium"
        };
    }

    private async Task EnsureAssigneeOptionsLoadedAsync()
    {
        if (_assigneeOptionsLoaded)
        {
            return;
        }

        var organizationId = AuthSessionService.User?.OrganizationId;
        if (!organizationId.HasValue || organizationId.Value == Guid.Empty)
        {
            _assigneeOptionsLoaded = true;
            return;
        }

        const int PageSize = 100;
        var page = 1;
        var users = new List<AssigneeOption>();

        while (true)
        {
            var result = await AdministrationApiClient.ListUsersAsync(
                AuthSessionService.AccessToken!,
                organizationId.Value,
                page,
                PageSize,
                null,
                CancellationToken.None);

            users.AddRange(result.Items.Select(user => new AssigneeOption
            {
                UserId = user.UserId,
                DisplayName = GetAssigneeDisplayName(user)
            }));

            if (users.Count >= result.TotalCount || result.Items.Count < result.PageSize)
            {
                break;
            }

            page++;
        }

        _assigneeOptions.Clear();
        _assigneeOptions.AddRange(users.OrderBy(user => user.DisplayName, StringComparer.OrdinalIgnoreCase));
        _assigneeOptionsLoaded = true;
    }

    private IdeaOverlayFormModel CreateEmptyIdeaForm()
    {
        return new IdeaOverlayFormModel
        {
            Priority = "Medium",
            StatusIdText = OrderedSwimlanes.FirstOrDefault()?.StatusId.ToString() ?? string.Empty
        };
    }

    private static IdeaOverlayFormModel CreateIdeaForm(IdeaDetailDto detail)
    {
        return new IdeaOverlayFormModel
        {
            Title = detail.Title,
            Description = detail.Description,
            Priority = detail.Priority,
            DueDate = detail.DueDate,
            AssigneeUserIdText = detail.AssigneeUserId?.ToString() ?? string.Empty,
            StatusIdText = detail.StatusId.ToString(),
            TagText = string.Join(", ", detail.TagNames),
            MentionText = string.Join(", ", detail.Mentions)
        };
    }

    private bool TryCreateIdeaWriteRequest(out IdeaWriteRequestDto request)
    {
        request = new IdeaWriteRequestDto();

        if (!Guid.TryParse(_ideaForm.StatusIdText, out var statusId))
        {
            return false;
        }

        request = new IdeaWriteRequestDto
        {
            Title = _ideaForm.Title.Trim(),
            Description = _ideaForm.Description.Trim(),
            Priority = _ideaForm.Priority,
            DueDate = _ideaForm.DueDate,
            AssigneeUserId = Guid.TryParse(_ideaForm.AssigneeUserIdText, out var assigneeUserId)
                ? assigneeUserId
                : null,
            StatusId = statusId,
            TagNames = ParseCommaSeparated(_ideaForm.TagText),
            MentionEmails = ParseMentionEmails(_ideaForm.MentionText)
        };

        return true;
    }

    private static IReadOnlyList<string> ParseCommaSeparated(string input)
    {
        return input
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static IReadOnlyList<string> ParseMentionEmails(string input)
    {
        return input
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => value.Trim().TrimStart('@'))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static string GetAssigneeDisplayName(UserListItemDto user)
    {
        var fullName = $"{user.FirstName} {user.LastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? user.Email : $"{fullName} ({user.Email})";
    }

    private string GetFilterButtonClass(IdeaFilter filter)
    {
        return _filter == filter ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
    }

