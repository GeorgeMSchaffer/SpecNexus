@page "/ideas"
@inject IAuthSessionService AuthSessionService
@inject IClientErrorMessageService ErrorMessageService
@inject NavigationManager NavigationManager
@inject WorkflowApiClient WorkflowApiClient

<PageTitle>My Ideas</PageTitle>

<AuthGate>
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h3 mb-1">My Ideas</h1>
                <p class="text-muted mb-0">Ideas you created or are assigned to.</p>
            </div>
        </div>

        @if (_loading)
        {
            <div class="alert alert-info">Loading ideas…</div>
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        else
        {
            <div class="mb-3 d-flex gap-2">
                <button class="@FilterBtnClass(IdeaFilter.All)" @onclick="() => SetFilter(IdeaFilter.All)">All</button>
                <button class="@FilterBtnClass(IdeaFilter.CreatedByMe)" @onclick="() => SetFilter(IdeaFilter.CreatedByMe)">Created by me</button>
                <button class="@FilterBtnClass(IdeaFilter.AssignedToMe)" @onclick="() => SetFilter(IdeaFilter.AssignedToMe)">Assigned to me</button>
            </div>

            <SearchPaginationBar @bind-SearchText="_search"
                                 @bind-PageSize="_pageSize"
                                 OnSearch="HandleSearchAsync" />

            @if (_totalCount == 0)
            {
                <div class="alert alert-secondary">No ideas found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Created By</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var idea in _ideas)
                            {
                                var ideaId = idea.IdeaId;
                                <tr>
                                    <td>@idea.Title</td>
                                    <td>@(idea.AuthorDisplayName ?? idea.AuthorUserId.ToString("D")[..8])</td>
                                    <td>@(idea.AssigneeDisplayName ?? "—")</td>
                                    <td>@idea.StatusName</td>
                                    <td>@idea.CreatedAtUtc.ToLocalTime().ToString("d")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewIdea(ideaId)">Details</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="text-muted small">
                        Showing @((_page - 1) * _pageSize + 1)–@Math.Min(_page * _pageSize, _totalCount) of @_totalCount
                    </span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(_page <= 1)">← Prev</button>
                        <span class="align-self-center small">Page @_page</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(_page * _pageSize >= _totalCount)">Next →</button>
                    </div>
                </div>
            }
        }
    </div>
</AuthGate>

@code {
    private enum IdeaFilter { All, CreatedByMe, AssignedToMe }

    private IReadOnlyList<IdeaListItemDto> _ideas = Array.Empty<IdeaListItemDto>();
    private IdeaFilter _filter = IdeaFilter.All;
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _errorMessage;
    private int _page = 1;
    private int _pageSize = 25;
    private int _totalCount;

    private string FilterApiValue => _filter switch
    {
        IdeaFilter.CreatedByMe => "createdByMe",
        IdeaFilter.AssignedToMe => "assignedToMe",
        _ => "all"
    };

    private string FilterBtnClass(IdeaFilter f) =>
        _filter == f ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var orgId = AuthSessionService.User?.OrganizationId;
            if (!orgId.HasValue)
            {
                _errorMessage = "Your account is not associated with an organization.";
                return;
            }

            var result = await WorkflowApiClient.ListMyIdeasAsync(
                AuthSessionService.AccessToken!,
                orgId.Value,
                _page,
                _pageSize,
                _search,
                FilterApiValue,
                CancellationToken.None);

            _ideas = result.Items;
            _totalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ViewIdea(Guid ideaId) => NavigationManager.NavigateTo($"/ideas/{ideaId}/edit");

    private async Task SetFilter(IdeaFilter filter)
    {
        _filter = filter;
        _page = 1;
        await LoadAsync();
    }

    private async Task HandleSearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }

    private async Task NextPage()
    {
        if (_page * _pageSize < _totalCount)
        {
            _page++;
            await LoadAsync();
        }
    }
}
