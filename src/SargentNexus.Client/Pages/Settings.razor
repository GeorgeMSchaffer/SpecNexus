@page "/settings"
@inject IAuthSessionService AuthSessionService

<PageTitle>Settings</PageTitle>

<AuthGate>
    <div class="container py-4">
        <h1 class="h3 mb-3">Settings</h1>
        <p class="text-muted mb-4">Manage your profile and application settings.</p>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h6">My Profile</h2>
                        <p class="mb-0 text-muted">Update your name, email, and password.</p>
                        <NavLink class="btn btn-sm btn-outline-primary mt-3" href="/settings/profile">Open profile</NavLink>
                    </div>
                </div>
            </div>

            @if (IsSiteAdmin)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Organizations</h2>
                            <p class="mb-0 text-muted">Create, edit, and archive organizations.</p>
                            <NavLink class="btn btn-sm btn-outline-primary mt-3" href="/settings/organizations">Open organizations</NavLink>
                        </div>
                    </div>
                </div>
            }

            @if (IsSiteAdmin || IsOrgAdmin)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Users</h2>
                            <p class="mb-0 text-muted">Manage organization users and roles.</p>
                            <NavLink class="btn btn-sm btn-outline-primary mt-3" href="/settings/users">Open users</NavLink>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Boards &amp; Statuses</h2>
                            <p class="mb-0 text-muted">Configure boards, statuses, and swimlanes.</p>
                            <NavLink class="btn btn-sm btn-outline-primary mt-3" href="/settings/boards">Open boards</NavLink>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</AuthGate>

@code {
    private bool IsSiteAdmin => string.Equals(AuthSessionService.User?.Role, "SiteAdmin", StringComparison.OrdinalIgnoreCase);
    private bool IsOrgAdmin => string.Equals(AuthSessionService.User?.Role, "OrgAdmin", StringComparison.OrdinalIgnoreCase);
}
