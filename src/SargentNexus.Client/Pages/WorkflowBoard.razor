    private bool CanCreateIdea
    {
        get
        {
            var role = AuthSessionService.User?.Role ?? string.Empty;
            return string.Equals(role, "SiteAdmin", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "OrgAdmin", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "User", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool IsAdmin =>
        string.Equals(AuthSessionService.User?.Role, "SiteAdmin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSessionService.User?.Role, "OrgAdmin", StringComparison.OrdinalIgnoreCase);

    private bool CanMoveIdeas => IsAdmin || (_board?.AllowUserStatusUpdate == true && CanCreateIdea);

    private bool CanEditRestrictedFields =>
        IsAdmin || (_overlayIdeaId.HasValue && FindCard(_overlayIdeaId.Value)?.AuthorUserId == AuthSessionService.User?.UserId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCommentsAfterRender && _overlayIdea is not null && !_overlayLoading)
        {
            _focusCommentsAfterRender = false;
            await _commentComposer.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_board is null || _board.BoardId != BoardId)
        {
            await LoadAsync();
        }

        if (CreateRequested && !_createRequestHandled && CanCreateIdea && _board is not null)
        {
            _createRequestHandled = true;
            StartCreateIdea();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            if (!AuthSessionService.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            _board = await WorkflowApiClient.GetBoardDetailAsync(AuthSessionService.AccessToken!, BoardId, CancellationToken.None);
            _swimlanes = _board.Swimlanes
                .Where(s => !s.IsDeletedStatus)
                .OrderBy(s => s.Order)
                .ToList();

            _ideasResult = await WorkflowApiClient.ListIdeasAsync(AuthSessionService.AccessToken!, BoardId, CancellationToken.None);
            _ideas.Clear();
            _ideas.AddRange(_ideasResult.Items);
            SynchronizeIdeaResult();
            await LoadEditorOptionsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool HasActiveFilters => _ideaFilter != "all" || !string.IsNullOrWhiteSpace(_searchText);

    private int VisibleIdeaCount => _ideas.Count(MatchesActiveFilters);

    private List<IdeaListItemDto> IdeasForSwimlane(Guid statusId) =>
        _ideas.Where(idea => idea.StatusId == statusId && MatchesActiveFilters(idea)).ToList();

    private async Task LoadEditorOptionsAsync()
    {
        if (_board is null)
        {
            return;
        }

        var ideaTypesTask = WorkflowApiClient.ListIdeaTypesAsync(
            AuthSessionService.AccessToken!, _board.OrganizationId, CancellationToken.None);
        var businessImpactsTask = WorkflowApiClient.ListBusinessImpactsAsync(
            AuthSessionService.AccessToken!, _board.OrganizationId, CancellationToken.None);
        var usersTask = AdministrationApiClient.ListUsersAsync(
            AuthSessionService.AccessToken!, _board.OrganizationId, 1, 200, null, CancellationToken.None);

        try
        {
            _ideaTypes = (await ideaTypesTask).OrderBy(item => item.SortOrder).ThenBy(item => item.Name).ToList();
        }
        catch
        {
            _ideaTypes = _ideas
                .GroupBy(item => item.IdeaTypeId)
                .Select(group => new IdeaTypeSummaryDto
                {
                    IdeaTypeId = group.Key,
                    OrganizationId = _board.OrganizationId,
                    Name = group.First().IdeaTypeName
                })
                .OrderBy(item => item.Name)
                .ToList();
        }

        try
        {
            _businessImpacts = (await businessImpactsTask).OrderBy(item => item.SortOrder).ThenBy(item => item.Name).ToList();
        }
        catch
        {
            _businessImpacts = _ideas
                .GroupBy(item => item.BusinessImpactId)
                .Select(group => new BusinessImpactSummaryDto
                {
                    BusinessImpactId = group.Key,
                    OrganizationId = _board.OrganizationId,
                    Name = group.First().BusinessImpactName,
                    Color = group.First().BusinessImpactColor
                })
                .OrderBy(item => item.Name)
                .ToList();
        }

        try
        {
            _organizationUsers = (await usersTask).Items
                .Where(item => string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(item => item.FirstName)
                .ThenBy(item => item.LastName)
                .ToList();
        }
        catch
        {
            _organizationUsers = new List<UserListItemDto>();
        }
    }

    private void SynchronizeIdeaResult()
    {
        _ideasResult.Items = _ideas.ToArray();
        _ideasResult.TotalCount = _ideas.Count;
    }

    private IdeaListItemDto? FindCard(Guid ideaId) => _ideas.FirstOrDefault(item => item.IdeaId == ideaId);

    private void ApplyDetailToCard(IdeaDetailDto detail)
    {
        var card = FindCard(detail.IdeaId);
        if (card is null)
        {
            return;
        }

        card.Title = detail.Title;
        card.Priority = detail.Priority;
        card.IdeaTypeId = detail.IdeaTypeId;
        card.IdeaTypeName = detail.IdeaTypeName;
        card.BusinessImpactId = detail.BusinessImpactId;
        card.BusinessImpactName = detail.BusinessImpactName;
        card.BusinessImpactColor = detail.BusinessImpactColor;
        card.DueDate = detail.DueDate;
        card.Assignees = detail.Assignees;
        card.TagNames = detail.TagNames;
        card.StatusId = detail.StatusId;
        card.StatusName = detail.StatusName;
        card.UpvoteCount = detail.UpvoteCount;
        card.HasUpvoted = detail.HasUpvoted;
        card.CommentCount = detail.CommentCount;
    }

    private bool MatchesActiveFilters(IdeaListItemDto idea)
    {
        var currentUserId = AuthSessionService.User?.UserId;
        var matchesPersonalFilter = _ideaFilter switch
        {
            "created" => currentUserId.HasValue && idea.AuthorUserId == currentUserId.Value,
            "assigned" => currentUserId.HasValue && idea.Assignees.Any(assignee => assignee.UserId == currentUserId.Value),
            _ => true
        };

        if (!matchesPersonalFilter || string.IsNullOrWhiteSpace(_searchText))
        {
            return matchesPersonalFilter;
        }

        var searchText = _searchText.Trim();
        return idea.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || idea.Assignees.Any(assignee => assignee.DisplayName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            || (idea.AuthorDisplayName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void ShowAllIdeas() => _ideaFilter = "all";

    private void ShowCreatedIdeas() => _ideaFilter = "created";

    private void ShowAssignedIdeas() => _ideaFilter = "assigned";

    private string FilterButtonClass(string filter) =>
        _ideaFilter == filter ? "board-filter-picker__button is-active" : "board-filter-picker__button";

    private void SetJiraStyle() => _boardStyle = "jira";

    private void SetTrelloStyle() => _boardStyle = "trello";

    private void SetFocusStyle() => _boardStyle = "focus";

    private string StyleButtonClass(string style) =>
        _boardStyle == style ? "board-style-picker__button is-active" : "board-style-picker__button";

    private static string AssigneeInitials(string displayName) =>
        string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private static string FormatAssignees(IReadOnlyList<IdeaAssigneeSummaryDto> assignees) =>
        string.Join(", ", assignees.Select(assignee => assignee.DisplayName));

    private async Task HandleCardKeyDown(KeyboardEventArgs args, Guid ideaId)
    {
        if (args.Key is "Enter" or " ")
        {
            await OpenIdeaOverlay(ideaId);
        }
    }

    private async Task OpenIdeaOverlay(Guid ideaId, bool focusComments = false)
    {
        _overlayIdeaId = ideaId;
        _overlayIdea = null;
        _overlayLoading = true;
        _overlayError = null;
        _overlayComment = new OverlayCommentModel();
        _overlayEditing = false;
        _overlayDeleteConfirming = false;
        _focusCommentsAfterRender = focusComments;

        try
        {
            _overlayIdea = await WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, ideaId, CancellationToken.None);
            _overlaySelectedStatusId = _overlayIdea.StatusId;
            _overlayHasUpvoted = _overlayIdea.HasUpvoted;
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _overlayLoading = false;
        }
    }

    private async Task CloseOverlay()
    {
        _overlayIdeaId = null;
        _overlayIdea = null;
        _overlayEditing = false;
        _overlayDeleteConfirming = false;
        await Task.CompletedTask;
    }

    private async Task OverlayHandleStatusChangeAsync(ChangeEventArgs args)
    {
        if (_overlayIdea is null || !Guid.TryParse(args.Value?.ToString(), out var statusId))
        {
            return;
        }

        await MoveCardAsync(_overlayIdea.IdeaId, statusId);
    }

    private async Task OverlayToggleUpvoteAsync()
    {
        if (_overlayIdea is null)
        {
            return;
        }

        await ToggleCardUpvoteAsync(_overlayIdea.IdeaId);
    }

    private async Task OverlayAddCommentAsync()
    {
        if (_overlayIdea is null)
        {
            return;
        }

        _overlaySubmitting = true;
        try
        {
            await WorkflowApiClient.CreateCommentAsync(
                AuthSessionService.AccessToken!,
                _overlayIdea.IdeaId,
                new CommentWriteRequestDto { Body = _overlayComment.Body.Trim() },
                CancellationToken.None);

            _overlayComment = new OverlayCommentModel();
            _overlayIdea = await WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, _overlayIdea.IdeaId, CancellationToken.None);
            _overlayHasUpvoted = _overlayIdea.HasUpvoted;
            ApplyDetailToCard(_overlayIdea);
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _overlaySubmitting = false;
        }
    }

    private void StartCreateIdea()
    {
        _createForm = new CreateIdeaFormModel
        {
            Priority = "Medium",
            IdeaTypeId = _ideaTypes.FirstOrDefault(item => !item.IsDeleted)?.IdeaTypeId ?? Guid.Empty,
            BusinessImpactId = _businessImpacts.FirstOrDefault(item => !item.IsDeleted)?.BusinessImpactId ?? Guid.Empty
        };
        _createError = null;
        _showCreateForm = true;
    }

    private void CancelCreate()
    {
        _showCreateForm = false;
        _createError = null;
    }

    private async Task SaveNewIdeaAsync()
    {
        _isSubmitting = true;
        _createError = null;

        try
        {
            DateOnly? dueDate = null;
            if (!string.IsNullOrWhiteSpace(_createForm.DueDateString)
                && DateOnly.TryParse(_createForm.DueDateString, out var parsed))
            {
                dueDate = parsed;
            }

            await WorkflowApiClient.CreateIdeaAsync(
                AuthSessionService.AccessToken!,
                BoardId,
                new IdeaWriteRequestDto
                {
                    Title = _createForm.Title.Trim(),
                    Description = _createForm.Description?.Trim() ?? string.Empty,
                    Priority = _createForm.Priority,
                    IdeaTypeId = _createForm.IdeaTypeId,
                    BusinessImpactId = _createForm.BusinessImpactId,
                    DueDate = dueDate,
                    AssigneeUserIds = _createForm.AssigneeUserIds.ToArray(),
                    TagNames = _createForm.TagNames.ToArray()
                },
                CancellationToken.None);

            _showCreateForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _createError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void BeginDrag(Guid ideaId)
    {
        if (CanMoveIdeas)
        {
            _draggedIdeaId = ideaId;
            _operationError = null;
        }
    }

    private async Task DropOnLaneAsync(Guid statusId)
    {
        if (_draggedIdeaId is Guid ideaId)
        {
            _draggedIdeaId = null;
            await MoveCardAsync(ideaId, statusId);
        }
    }

    private async Task MoveCardAsync(Guid ideaId, Guid statusId)
    {
        var card = FindCard(ideaId);
        var targetLane = _swimlanes.FirstOrDefault(item => item.StatusId == statusId);
        if (card is null || targetLane is null || card.StatusId == statusId || !CanMoveIdeas)
        {
            return;
        }

        var previousStatusId = card.StatusId;
        var previousStatusName = card.StatusName;
        card.StatusId = statusId;
        card.StatusName = targetLane.StatusName;
        _operationError = null;
        _overlayError = null;

        if (_overlayIdea?.IdeaId == ideaId)
        {
            _overlaySubmitting = true;
            _overlaySelectedStatusId = statusId;
            _overlayIdea.StatusId = statusId;
            _overlayIdea.StatusName = targetLane.StatusName;
        }

        try
        {
            await WorkflowApiClient.MoveIdeaStatusAsync(AuthSessionService.AccessToken!, ideaId, statusId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            card.StatusId = previousStatusId;
            card.StatusName = previousStatusName;
            var message = ErrorMessageService.GetDisplayMessage(null, null, ex);
            _operationError = message;

            if (_overlayIdea?.IdeaId == ideaId)
            {
                _overlaySelectedStatusId = previousStatusId;
                _overlayIdea.StatusId = previousStatusId;
                _overlayIdea.StatusName = previousStatusName;
                _overlayError = message;
            }
        }
        finally
        {
            _overlaySubmitting = false;
        }
    }

    private async Task ToggleCardUpvoteAsync(Guid ideaId)
    {
        var card = FindCard(ideaId);
        if (card is null || !_upvoteInFlight.Add(ideaId))
        {
            return;
        }

        var previousHasUpvoted = card.HasUpvoted;
        var previousCount = card.UpvoteCount;
        card.HasUpvoted = !card.HasUpvoted;
        card.UpvoteCount = Math.Max(0, card.UpvoteCount + (card.HasUpvoted ? 1 : -1));
        SynchronizeOverlayUpvote(card);
        _operationError = null;

        try
        {
            var result = await WorkflowApiClient.ToggleUpvoteAsync(AuthSessionService.AccessToken!, ideaId, CancellationToken.None);
            card.HasUpvoted = result.HasUpvoted;
            card.UpvoteCount = result.UpvoteCount;
            SynchronizeOverlayUpvote(card);
        }
        catch (Exception ex)
        {
            card.HasUpvoted = previousHasUpvoted;
            card.UpvoteCount = previousCount;
            SynchronizeOverlayUpvote(card);
            _operationError = ErrorMessageService.GetDisplayMessage(null, null, ex);
            _overlayError = _overlayIdea?.IdeaId == ideaId ? _operationError : _overlayError;
        }
        finally
        {
            _upvoteInFlight.Remove(ideaId);
        }
    }

    private void SynchronizeOverlayUpvote(IdeaListItemDto card)
    {
        if (_overlayIdea?.IdeaId == card.IdeaId)
        {
            _overlayHasUpvoted = card.HasUpvoted;
            _overlayIdea.HasUpvoted = card.HasUpvoted;
            _overlayIdea.UpvoteCount = card.UpvoteCount;
        }
    }

    private void StartOverlayEdit()
    {
        if (_overlayIdea is null)
        {
            return;
        }

        _overlayEditForm = new IdeaEditFormModel
        {
            Title = _overlayIdea.Title,
            Description = _overlayIdea.Description,
            Priority = _overlayIdea.Priority,
            IdeaTypeId = _overlayIdea.IdeaTypeId,
            BusinessImpactId = _overlayIdea.BusinessImpactId,
            DueDateString = _overlayIdea.DueDate?.ToString("yyyy-MM-dd"),
            AssigneeUserIds = _overlayIdea.Assignees.Select(item => item.UserId).ToHashSet(),
            TagNames = _overlayIdea.TagNames.ToList()
        };
        _overlayEditing = true;
        _overlayError = null;
    }

    private async Task SaveOverlayEditAsync()
    {
        if (_overlayIdea is null)
        {
            return;
        }

        _overlaySubmitting = true;
        _overlayError = null;
        try
        {
            var updated = await WorkflowApiClient.UpdateIdeaAsync(
                AuthSessionService.AccessToken!,
                _overlayIdea.IdeaId,
                new IdeaWriteRequestDto
                {
                    Title = _overlayEditForm.Title.Trim(),
                    Description = _overlayEditForm.Description.Trim(),
                    Priority = _overlayEditForm.Priority,
                    IdeaTypeId = _overlayEditForm.IdeaTypeId,
                    BusinessImpactId = _overlayEditForm.BusinessImpactId,
                    DueDate = ParseDate(_overlayEditForm.DueDateString),
                    AssigneeUserIds = _overlayEditForm.AssigneeUserIds.ToArray(),
                    StatusId = _overlayIdea.StatusId,
                    TagNames = _overlayEditForm.TagNames.ToArray()
                },
                CancellationToken.None);

            _overlayIdea = updated;
            _overlayHasUpvoted = updated.HasUpvoted;
            _overlaySelectedStatusId = updated.StatusId;
            ApplyDetailToCard(updated);
            _overlayEditing = false;
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _overlaySubmitting = false;
        }
    }

    private async Task DeleteOverlayIdeaAsync()
    {
        if (_overlayIdea is null || !IsAdmin)
        {
            return;
        }

        if (!_overlayDeleteConfirming)
        {
            _overlayDeleteConfirming = true;
            return;
        }

        _overlaySubmitting = true;
        try
        {
            var ideaId = _overlayIdea.IdeaId;
            await WorkflowApiClient.DeleteIdeaAsync(AuthSessionService.AccessToken!, ideaId, CancellationToken.None);
            _ideas.RemoveAll(item => item.IdeaId == ideaId);
            SynchronizeIdeaResult();
            await CloseOverlay();
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
            _overlayDeleteConfirming = false;
        }
        finally
        {
            _overlaySubmitting = false;
        }
    }

    private static DateOnly? ParseDate(string? value) =>
        DateOnly.TryParse(value, out var parsed) ? parsed : null;

    private static void ToggleSelection(HashSet<Guid> selections, Guid userId, bool isSelected)
    {
        if (isSelected && selections.Count < 5)
        {
            selections.Add(userId);
        }
        else if (!isSelected)
        {
            selections.Remove(userId);
        }
    }

    private static void AddTag(List<string> tags, string value)
    {
        var tag = value.Trim();
        if (tag.Length > 0 && tags.Count < 10 && !tags.Contains(tag, StringComparer.OrdinalIgnoreCase))
        {
            tags.Add(tag);
            tags.Sort(StringComparer.OrdinalIgnoreCase);
        }
    }

    private static string PriorityBadgeClass(string priority) => priority.ToLowerInvariant() switch
    {
        "critical" => "text-bg-danger",
        "high"     => "text-bg-warning",
        "medium"   => "text-bg-primary",
        "low"      => "text-bg-secondary",
        _          => "text-bg-light"
    };

