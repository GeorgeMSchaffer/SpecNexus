    private Guid? _overlayIdeaId;
    private IdeaDetailDto? _overlayIdea;
    private bool _overlayLoading;
    private bool _overlaySubmitting;
    private string? _overlayError;
    private Guid _overlaySelectedStatusId;
    private bool _overlayHasUpvoted;
    private bool _overlayEditing;
    private bool _overlayDeleteConfirming;
