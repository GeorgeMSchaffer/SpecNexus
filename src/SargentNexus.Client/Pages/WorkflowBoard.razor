@page "/board/{BoardId:guid}"
@inject IAuthSessionService AuthSessionService
@inject IClientErrorMessageService ErrorMessageService
@inject NavigationManager NavigationManager
@inject WorkflowApiClient WorkflowApiClient
@inject AdministrationApiClient AdministrationApiClient
@inject IClientClock ClientClock

<PageTitle>@(_board?.Name ?? "Board")</PageTitle>

<AuthGate>
    <main class="workflow-board workflow-board--@_boardStyle">
        <header class="workflow-board__toolbar">
            <NavLink class="workflow-board__back" href="/boards" aria-label="Back to boards">←</NavLink>

            @if (_board is not null)
            {
                <div class="workflow-board__heading">
                    <h1>@_board.Name</h1>
                    <span>@(_board.AllowUserStatusUpdate ? "User-managed" : "Admin-managed") board</span>
                </div>
            }

            <div class="workflow-board__actions">
                <div class="board-style-picker" role="group" aria-label="Board style">
                    <button type="button" class="@StyleButtonClass("jira")" aria-pressed="@(_boardStyle == "jira")" @onclick="SetJiraStyle">Jira</button>
                    <button type="button" class="@StyleButtonClass("trello")" aria-pressed="@(_boardStyle == "trello")" @onclick="SetTrelloStyle">Trello</button>
                    <button type="button" class="@StyleButtonClass("focus")" aria-pressed="@(_boardStyle == "focus")" @onclick="SetFocusStyle">Focus</button>
                </div>
                @if (CanCreateIdea)
                {
                    <button class="workflow-board__new" @onclick="StartCreateIdea"><span aria-hidden="true">+</span> New idea</button>
                }
            </div>
        </header>

        @if (_loading)
        {
            <div class="workflow-board__message d-flex align-items-center gap-2 text-muted py-4">
                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                <span>Loading board…</span>
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        else if (_board is not null)
        {
            <div class="workflow-board__controls">
                <div class="workflow-board__search">
                    <label for="board-search">Search ideas</label>
                    <input id="board-search"
                           type="search"
                           @bind="_searchText"
                           @bind:event="oninput"
                           placeholder="Search title or assignee" />
                </div>
                <div class="board-filter-picker" role="group" aria-label="Filter ideas">
                    <button type="button" class="@FilterButtonClass("all")" aria-pressed="@(_ideaFilter == "all")" @onclick="ShowAllIdeas">All</button>
                    <button type="button" class="@FilterButtonClass("created")" aria-pressed="@(_ideaFilter == "created")" @onclick="ShowCreatedIdeas">Created by me</button>
                    <button type="button" class="@FilterButtonClass("assigned")" aria-pressed="@(_ideaFilter == "assigned")" @onclick="ShowAssignedIdeas">Assigned to me</button>
                </div>
                <span class="workflow-board__result-count">@VisibleIdeaCount of @_ideas.Count ideas</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_operationError))
            {
                <div class="workflow-board__operation-error" role="alert">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span>@_operationError</span>
                    <button type="button" aria-label="Dismiss error" @onclick="() => _operationError = null">×</button>
                </div>
            }

            @if (_showCreateForm)
            {
                <div class="workflow-board__create-backdrop" @onclick="CancelCreate"></div>
                <aside class="workflow-board__create-form" role="dialog" aria-modal="true" aria-labelledby="new-idea-title" @onclick:stopPropagation="true">
                    <header class="workflow-board__form-header">
                        <div>
                            <span>New card</span>
                            <h2 id="new-idea-title">Create an idea</h2>
                        </div>
                        <button type="button" aria-label="Close new idea form" @onclick="CancelCreate">×</button>
                    </header>
                    <EditForm Model="_createForm" OnValidSubmit="SaveNewIdeaAsync" class="workflow-board__form">
                            <DataAnnotationsValidator />
                            <div class="workflow-board__field workflow-board__field--full">
                                <label class="form-label">Title <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_createForm.Title" />
                                <ValidationMessage For="() => _createForm.Title" />
                            </div>
                            <div class="workflow-board__field workflow-board__field--full">
                                <label class="form-label">Description</label>
                                <InputTextArea class="form-control" rows="5" @bind-Value="_createForm.Description" />
                            </div>
                            <div class="workflow-board__form-grid">
                                <div class="workflow-board__field">
                                    <label class="form-label">Priority</label>
                                    <InputSelect class="form-select" @bind-Value="_createForm.Priority">
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                        <option value="Critical">Critical</option>
                                    </InputSelect>
                                </div>
                                <div class="workflow-board__field">
                                    <label class="form-label">Due date</label>
                                    <input type="date" class="form-control"
                                           value="@_createForm.DueDateString"
                                           @onchange="e => _createForm.DueDateString = e.Value?.ToString()" />
                                </div>
                            </div>
                            <div class="workflow-board__form-grid">
                                <div class="workflow-board__field">
                                    <label class="form-label">Idea Type <span class="text-danger">*</span></label>
                                    <InputSelect class="form-select" @bind-Value="_createForm.IdeaTypeId">
                                        @foreach (var item in _ideaTypes.Where(item => !item.IsDeleted))
                                        {
                                            <option value="@item.IdeaTypeId">@item.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => _createForm.IdeaTypeId" />
                                </div>
                                <div class="workflow-board__field">
                                    <label class="form-label">Business Impact <span class="text-danger">*</span></label>
                                    <InputSelect class="form-select" @bind-Value="_createForm.BusinessImpactId">
                                        @foreach (var item in _businessImpacts.Where(item => !item.IsDeleted))
                                        {
                                            <option value="@item.BusinessImpactId">@item.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => _createForm.BusinessImpactId" />
                                </div>
                            </div>
                            <fieldset class="workflow-board__selection-list">
                                <legend>Assignees <span>@_createForm.AssigneeUserIds.Count/5</span></legend>
                                @foreach (var user in _organizationUsers)
                                {
                                    var isSelected = _createForm.AssigneeUserIds.Contains(user.UserId);
                                    <label>
                                        <input type="checkbox"
                                               checked="@isSelected"
                                               disabled="@(!isSelected && _createForm.AssigneeUserIds.Count >= 5)"
                                               @onchange="args => ToggleSelection(_createForm.AssigneeUserIds, user.UserId, args.Value is true)" />
                                        <span>@user.FirstName @user.LastName</span>
                                    </label>
                                }
                            </fieldset>
                            <div class="workflow-board__field">
                                <label class="form-label" for="create-tag">Tags <span>@_createForm.TagNames.Count/10</span></label>
                                <div class="workflow-board__tag-entry">
                                    <InputText id="create-tag" class="form-control" @bind-Value="_createForm.TagEntry" />
                                    <button type="button" class="btn btn-outline-secondary" disabled="@(_createForm.TagNames.Count >= 10)"
                                            @onclick="() => { AddTag(_createForm.TagNames, _createForm.TagEntry); _createForm.TagEntry = string.Empty; }">Add</button>
                                </div>
                                <div class="workflow-board__tag-list" aria-label="Selected tags">
                                    @foreach (var tag in _createForm.TagNames)
                                    {
                                        <span>@tag <button type="button" aria-label="Remove @tag" @onclick="() => _createForm.TagNames.Remove(tag)">×</button></span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_createError))
                            {
                                <div class="workflow-board__form-error" role="alert">@_createError</div>
                            }
                            <div class="workflow-board__form-actions">
                                <button class="btn btn-outline-secondary" type="button" @onclick="CancelCreate">Cancel</button>
                                <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
                                    @(_isSubmitting ? "Creating…" : "Create idea")
                                </button>
                            </div>
                    </EditForm>
                </aside>
            }

            @if (_swimlanes.Count == 0)
            {
                <div class="alert alert-secondary">
                    <strong>No swimlanes configured.</strong>
                    An administrator can add statuses and configure this board in
                    <a href="/settings/boards">Settings → Boards &amp; Statuses</a>.
                </div>
            }
            else
            {
                <div class="board-stage">
                <div class="board-columns">
                    @foreach (var swimlane in _swimlanes)
                    {
                        var laneIdeas = IdeasForSwimlane(swimlane.StatusId);
                        <section class="board-column @(_draggedIdeaId.HasValue ? "is-drop-target" : null)"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => DropOnLaneAsync(swimlane.StatusId)">
                            <div class="board-column-header">
                                <span class="board-column-title">@swimlane.StatusName</span>
                                <span class="board-column-count">@laneIdeas.Count</span>
                            </div>

                            @if (laneIdeas.Count == 0)
                            {
                                <div class="board-card-empty">
                                    @if (HasActiveFilters)
                                    {
                                        <strong>No matching ideas</strong>
                                        <span>Try another search or filter.</span>
                                    }
                                    else
                                    {
                                        <strong>No ideas here yet</strong>
                                        <span>This lane is ready for its first idea.</span>
                                        @if (CanCreateIdea)
                                        {
                                            <button type="button" @onclick="StartCreateIdea">Add an idea</button>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                @foreach (var idea in laneIdeas)
                                {
                                    var ideaId = idea.IdeaId;
                                    <article class="board-card">
                                        <div class="board-card__body">
                                            <div class="board-card__topline">
                                                @if (CanMoveIdeas)
                                                {
                                                    <button type="button" class="board-card__drag" draggable="true"
                                                            title="Drag to move" aria-label="Drag @idea.Title to another lane"
                                                            @ondragstart="() => BeginDrag(ideaId)" @ondragend="() => _draggedIdeaId = null">
                                                        <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                                                    </button>
                                                }
                                                <button type="button" class="board-card__title" title="@idea.Title" @onclick="() => OpenIdeaOverlay(ideaId)">@idea.Title</button>
                                            </div>
                                            <div class="board-card__meta">
                                                <span class="board-card__impact" style="--impact-color:@idea.BusinessImpactColor" title="Business Impact: @idea.BusinessImpactName">@idea.BusinessImpactName</span>
                                                <span title="Created @ClientClock.FormatLocalDayAge(idea.CreatedAtUtc)">@ClientClock.FormatLocalDayAge(idea.CreatedAtUtc)</span>
                                            </div>
                                            @if (idea.TagNames.Count > 0)
                                            {
                                                <div class="board-card__tags" aria-label="Tags: @string.Join(", ", idea.TagNames)">
                                                    @foreach (var tag in idea.TagNames.OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase).Take(3))
                                                    {
                                                        <span>@tag</span>
                                                    }
                                                    @if (idea.TagNames.Count > 3)
                                                    {
                                                        <span>+@(idea.TagNames.Count - 3)</span>
                                                    }
                                                </div>
                                            }
                                            @if (idea.Assignees.Count > 0)
                                            {
                                                var orderedAssignees = idea.Assignees.OrderBy(item => item.FirstName).ThenBy(item => item.LastName).ToList();
                                                <div class="board-card__assignees" aria-label="Assignees: @FormatAssignees(orderedAssignees)">
                                                    @foreach (var assignee in orderedAssignees.Take(3))
                                                    {
                                                        <span title="@assignee.DisplayName">@AssigneeInitials(assignee.DisplayName)</span>
                                                    }
                                                    @if (orderedAssignees.Count > 3)
                                                    {
                                                        <span title="@(orderedAssignees.Count - 3) more assignees">+@(orderedAssignees.Count - 3)</span>
                                                    }
                                                </div>
                                            }
                                            <div class="board-card__actions">
                                                <button type="button" class="@(idea.HasUpvoted ? "is-active" : null)"
                                                        aria-label="@(idea.HasUpvoted ? "Remove upvote" : "Upvote") @idea.Title"
                                                        aria-pressed="@idea.HasUpvoted" disabled="@_upvoteInFlight.Contains(ideaId)"
                                                        @onclick="() => ToggleCardUpvoteAsync(ideaId)">
                                                    <i class="bi bi-caret-up-fill" aria-hidden="true"></i><span>@idea.UpvoteCount</span>
                                                </button>
                                                <button type="button" aria-label="Open comments for @idea.Title" @onclick="() => OpenIdeaOverlay(ideaId, true)">
                                                    <i class="bi bi-chat-left-text" aria-hidden="true"></i><span>@idea.CommentCount</span>
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            }
                        </section>
                    }
                </div>
                </div>
            }
        }
    </main>

    @* Idea detail overlay *@
    @if (_overlayIdeaId.HasValue)
    {
        <div class="idea-overlay-backdrop" @onclick="CloseOverlay"></div>
        <aside class="idea-overlay-panel" role="dialog" aria-modal="true" aria-labelledby="idea-detail-title" @onclick:stopPropagation="true">
            <header class="idea-overlay__header">
                <div>
                    <span>Board card</span>
                    <h2 id="idea-detail-title">Idea details</h2>
                </div>
                <div class="idea-overlay__header-actions">
                    @if (_overlayIdea is not null)
                    {
                        @if (CanCreateIdea && !_overlayEditing)
                        {
                            <button type="button" class="idea-overlay__open" @onclick="StartOverlayEdit">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                        }
                        @if (IsAdmin)
                        {
                            <button type="button" class="idea-overlay__delete @(_overlayDeleteConfirming ? "is-confirming" : null)"
                                    disabled="@_overlaySubmitting" @onclick="DeleteOverlayIdeaAsync">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                                @(_overlayDeleteConfirming ? "Confirm delete" : "Delete")
                            </button>
                        }
                        <a class="idea-overlay__open"
                           href="/ideas/@_overlayIdea.IdeaId/edit"
                           title="Open full edit page">Open full view</a>
                    }
                    <button class="idea-overlay__close" aria-label="Close idea details" @onclick="CloseOverlay">×</button>
                </div>
            </header>

            @if (_overlayLoading)
            {
                <div class="idea-overlay__loading">
                    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                    <span>Loading…</span>
                </div>
            }
            else if (_overlayIdea is null && _overlayError is not null)
            {
                <div class="alert alert-danger py-2">@_overlayError</div>
            }
            else if (_overlayIdea is not null)
            {
                <div class="idea-overlay__content">
                @if (!string.IsNullOrWhiteSpace(_overlayError))
                {
                    <div class="alert alert-danger py-2" role="alert">@_overlayError</div>
                }
                @if (_overlayEditing)
                {
                    <EditForm Model="_overlayEditForm" OnValidSubmit="SaveOverlayEditAsync" class="idea-overlay__edit-form">
                        <DataAnnotationsValidator />
                        <div class="idea-overlay__field">
                            <label for="edit-title">Title</label>
                            <InputText id="edit-title" class="form-control" @bind-Value="_overlayEditForm.Title" />
                            <ValidationMessage For="() => _overlayEditForm.Title" />
                        </div>
                        <div class="idea-overlay__field">
                            <label for="edit-description">Description</label>
                            <InputTextArea id="edit-description" class="form-control" rows="5"
                                           disabled="@(!CanEditRestrictedFields)" @bind-Value="_overlayEditForm.Description" />
                            @if (!CanEditRestrictedFields)
                            {
                                <small>Only the author or an administrator can change the description.</small>
                            }
                        </div>
                        <div class="idea-overlay__edit-grid">
                            <div class="idea-overlay__field">
                                <label for="edit-priority">Priority</label>
                                <InputSelect id="edit-priority" class="form-select" @bind-Value="_overlayEditForm.Priority">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </InputSelect>
                            </div>
                            <div class="idea-overlay__field">
                                <label for="edit-due-date">Due date</label>
                                <input id="edit-due-date" type="date" class="form-control" value="@_overlayEditForm.DueDateString"
                                       @onchange="args => _overlayEditForm.DueDateString = args.Value?.ToString()" />
                            </div>
                            <div class="idea-overlay__field">
                                <label for="edit-idea-type">Idea Type</label>
                                <InputSelect id="edit-idea-type" class="form-select" @bind-Value="_overlayEditForm.IdeaTypeId">
                                    @foreach (var item in _ideaTypes.Where(item => !item.IsDeleted || item.IdeaTypeId == _overlayEditForm.IdeaTypeId))
                                    {
                                        <option value="@item.IdeaTypeId">@item.Name@(item.IsDeleted ? " (archived)" : null)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="idea-overlay__field">
                                <label for="edit-impact">Business Impact</label>
                                <InputSelect id="edit-impact" class="form-select" @bind-Value="_overlayEditForm.BusinessImpactId">
                                    @foreach (var item in _businessImpacts.Where(item => !item.IsDeleted || item.BusinessImpactId == _overlayEditForm.BusinessImpactId))
                                    {
                                        <option value="@item.BusinessImpactId">@item.Name@(item.IsDeleted ? " (archived)" : null)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        @if (CanEditRestrictedFields)
                        {
                            <fieldset class="workflow-board__selection-list">
                                <legend>Assignees <span>@_overlayEditForm.AssigneeUserIds.Count/5</span></legend>
                                @foreach (var assignee in _overlayIdea.Assignees.Where(item => !item.IsActive))
                                {
                                    <label class="is-inactive"><input type="checkbox" checked disabled /> <span>@assignee.DisplayName (inactive)</span></label>
                                }
                                @foreach (var user in _organizationUsers)
                                {
                                    var isSelected = _overlayEditForm.AssigneeUserIds.Contains(user.UserId);
                                    <label>
                                        <input type="checkbox" checked="@isSelected"
                                               disabled="@(!isSelected && _overlayEditForm.AssigneeUserIds.Count >= 5)"
                                               @onchange="args => ToggleSelection(_overlayEditForm.AssigneeUserIds, user.UserId, args.Value is true)" />
                                        <span>@user.FirstName @user.LastName</span>
                                    </label>
                                }
                            </fieldset>
                        }
                        <div class="idea-overlay__field">
                            <label for="edit-tag">Tags <span>@_overlayEditForm.TagNames.Count/10</span></label>
                            <div class="workflow-board__tag-entry">
                                <InputText id="edit-tag" class="form-control" @bind-Value="_overlayEditForm.TagEntry" />
                                <button type="button" class="btn btn-outline-secondary" disabled="@(_overlayEditForm.TagNames.Count >= 10)"
                                        @onclick="() => { AddTag(_overlayEditForm.TagNames, _overlayEditForm.TagEntry); _overlayEditForm.TagEntry = string.Empty; }">Add</button>
                            </div>
                            <div class="workflow-board__tag-list">
                                @foreach (var tag in _overlayEditForm.TagNames)
                                {
                                    <span>@tag <button type="button" aria-label="Remove @tag" @onclick="() => _overlayEditForm.TagNames.Remove(tag)">×</button></span>
                                }
                            </div>
                        </div>
                        <div class="idea-overlay__edit-actions">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _overlayEditing = false">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@_overlaySubmitting">@(_overlaySubmitting ? "Saving…" : "Save changes")</button>
                        </div>
                    </EditForm>
                }
                else
                {
                <h3 class="idea-overlay__title">@_overlayIdea.Title</h3>
                <div class="idea-overlay__summary">
                    <span class="idea-overlay__priority">@_overlayIdea.Priority</span>
                    <span class="idea-overlay__impact" style="--impact-color:@_overlayIdea.BusinessImpactColor">@_overlayIdea.BusinessImpactName</span>
                    <span>@_overlayIdea.IdeaTypeName</span>
                    @if (_overlayIdea.DueDate is not null)
                    {
                        <span>Due @_overlayIdea.DueDate.Value.ToString("MMM d, yyyy")</span>
                    }
                </div>

                <div class="idea-overlay__field">
                    <label for="idea-status">Status</label>
                    <select id="idea-status" class="form-select" value="@_overlaySelectedStatusId"
                            @onchange="OverlayHandleStatusChangeAsync" disabled="@_overlaySubmitting">
                        @foreach (var swimlane in _swimlanes)
                        {
                            <option value="@swimlane.StatusId">@swimlane.StatusName</option>
                        }
                    </select>
                </div>

                @if (!string.IsNullOrWhiteSpace(_overlayIdea.Description))
                {
                    <section class="idea-overlay__section">
                        <h4>Description</h4>
                        <p>@_overlayIdea.Description</p>
                    </section>
                }

                @if (_overlayIdea.Assignees.Count > 0)
                {
                    <section class="idea-overlay__section">
                        <h4>Assignees</h4>
                        <div class="idea-overlay__assignees">
                            @foreach (var assignee in _overlayIdea.Assignees.OrderBy(item => item.FirstName).ThenBy(item => item.LastName))
                            {
                                <span class="@(!assignee.IsActive ? "is-inactive" : null)">@AssigneeInitials(assignee.DisplayName) <strong>@assignee.DisplayName</strong></span>
                            }
                        </div>
                    </section>
                }

                <div class="idea-overlay__engagement">
                    <span>▲ @_overlayIdea.UpvoteCount upvotes</span>
                    <button type="button"
                            @onclick="OverlayToggleUpvoteAsync"
                            disabled="@_overlaySubmitting">
                        @(_overlayHasUpvoted ? "Remove upvote" : "Upvote")
                    </button>
                </div>

                @if (_overlayIdea.TagNames.Count > 0)
                {
                    <section class="idea-overlay__section">
                        <h4>Tags</h4>
                        <div class="idea-overlay__tags">
                            @foreach (var tag in _overlayIdea.TagNames)
                            {
                                <span>@tag</span>
                            }
                        </div>
                    </section>
                }

                <section class="idea-overlay__comments">
                <h4>Comments <span>@_overlayIdea.Comments.Count</span></h4>
                @if (_overlayIdea.Comments.Count == 0)
                {
                    <p class="idea-overlay__comments-empty">No comments yet. Start the conversation below.</p>
                }
                else
                {
                    <div class="idea-overlay__comment-list">
                        @foreach (var comment in _overlayIdea.Comments)
                        {
                            <article class="idea-overlay__comment">
                                <time datetime="@comment.CreatedAtUtc.ToString("O")">@comment.CreatedAtUtc.ToLocalTime().ToString("MMM d · h:mm tt")</time>
                                <p>@comment.Body</p>
                            </article>
                        }
                    </div>
                }

                <EditForm Model="_overlayComment" OnValidSubmit="OverlayAddCommentAsync" class="idea-overlay__composer">
                    <DataAnnotationsValidator />
                    <div>
                        <label for="idea-comment">Add a comment</label>
                        <textarea id="idea-comment" class="form-control" rows="3"
                                  @ref="_commentComposer"
                                  placeholder="Add a comment…"
                                  @bind="_overlayComment.Body"></textarea>
                        <ValidationMessage For="() => _overlayComment.Body" />
                    </div>
                    <button type="submit" disabled="@_overlaySubmitting">
                        @(_overlaySubmitting ? "Posting…" : "Post")
                    </button>
                </EditForm>
                </section>
                }
                </div>
            }
        </aside>
    }
</AuthGate>

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    [SupplyParameterFromQuery(Name = "create")]
    public bool CreateRequested { get; set; }

    private BoardSummaryDto? _board;
    private SargentNexus.Client.Workflow.PagedResultDto<IdeaListItemDto> _ideasResult = new();
    private readonly List<IdeaListItemDto> _ideas = new();
    private List<SwimlaneDto> _swimlanes = new();
    private List<IdeaTypeSummaryDto> _ideaTypes = new();
    private List<BusinessImpactSummaryDto> _businessImpacts = new();
    private List<UserListItemDto> _organizationUsers = new();

    private bool _loading = true;
    private bool _isSubmitting;
    private bool _showCreateForm;
    private bool _createRequestHandled;
    private string _boardStyle = "jira";
    private string _ideaFilter = "all";
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _operationError;
    private string? _createError;
