@page "/board/{BoardId:guid}"
@page "/workflow/{BoardId:guid}"
@inject IAuthSessionService AuthSessionService
@inject IClientErrorMessageService ErrorMessageService
@inject NavigationManager NavigationManager
@inject WorkflowApiClient WorkflowApiClient

<PageTitle>@(_board?.Name ?? "Board")</PageTitle>

<AuthGate>
    <main class="workflow-board workflow-board--@_boardStyle">
        <header class="workflow-board__toolbar">
            <NavLink class="workflow-board__back" href="/board" aria-label="Back to boards">←</NavLink>

            @if (_board is not null)
            {
                <div class="workflow-board__heading">
                    <h1>@_board.Name</h1>
                    <span>@(_board.AllowUserStatusUpdate ? "User-managed" : "Admin-managed") board</span>
                </div>
            }

            <div class="workflow-board__actions">
                <div class="board-style-picker" role="group" aria-label="Board style">
                    <button type="button" class="@StyleButtonClass("jira")" aria-pressed="@(_boardStyle == "jira")" @onclick="SetJiraStyle">Jira</button>
                    <button type="button" class="@StyleButtonClass("trello")" aria-pressed="@(_boardStyle == "trello")" @onclick="SetTrelloStyle">Trello</button>
                    <button type="button" class="@StyleButtonClass("focus")" aria-pressed="@(_boardStyle == "focus")" @onclick="SetFocusStyle">Focus</button>
                </div>
                @if (CanCreateIdea)
                {
                    <button class="workflow-board__new" @onclick="StartCreateIdea"><span aria-hidden="true">+</span> New idea</button>
                }
            </div>
        </header>

        @if (_loading)
        {
            <div class="workflow-board__message d-flex align-items-center gap-2 text-muted py-4">
                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                <span>Loading board…</span>
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        else if (_board is not null)
        {
            <div class="workflow-board__controls">
                <div class="workflow-board__search">
                    <label for="board-search">Search ideas</label>
                    <input id="board-search"
                           type="search"
                           @bind="_searchText"
                           @bind:event="oninput"
                           placeholder="Search title or assignee" />
                </div>
                <div class="board-filter-picker" role="group" aria-label="Filter ideas">
                    <button type="button" class="@FilterButtonClass("all")" aria-pressed="@(_ideaFilter == "all")" @onclick="ShowAllIdeas">All</button>
                    <button type="button" class="@FilterButtonClass("created")" aria-pressed="@(_ideaFilter == "created")" @onclick="ShowCreatedIdeas">Created by me</button>
                    <button type="button" class="@FilterButtonClass("assigned")" aria-pressed="@(_ideaFilter == "assigned")" @onclick="ShowAssignedIdeas">Assigned to me</button>
                </div>
                <span class="workflow-board__result-count">@VisibleIdeaCount of @_ideasResult.Items.Count ideas</span>
            </div>

            @if (_showCreateForm)
            {
                <div class="workflow-board__create-backdrop" @onclick="CancelCreate"></div>
                <aside class="workflow-board__create-form" role="dialog" aria-modal="true" aria-labelledby="new-idea-title" @onclick:stopPropagation="true">
                    <header class="workflow-board__form-header">
                        <div>
                            <span>New card</span>
                            <h2 id="new-idea-title">Create an idea</h2>
                        </div>
                        <button type="button" aria-label="Close new idea form" @onclick="CancelCreate">×</button>
                    </header>
                    <EditForm Model="_createForm" OnValidSubmit="SaveNewIdeaAsync" class="workflow-board__form">
                            <DataAnnotationsValidator />
                            <div class="workflow-board__field workflow-board__field--full">
                                <label class="form-label">Title <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_createForm.Title" />
                                <ValidationMessage For="() => _createForm.Title" />
                            </div>
                            <div class="workflow-board__field workflow-board__field--full">
                                <label class="form-label">Description</label>
                                <InputTextArea class="form-control" rows="5" @bind-Value="_createForm.Description" />
                            </div>
                            <div class="workflow-board__form-grid">
                                <div class="workflow-board__field">
                                    <label class="form-label">Priority</label>
                                    <InputSelect class="form-select" @bind-Value="_createForm.Priority">
                                        <option value="">No priority</option>
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                        <option value="Critical">Critical</option>
                                    </InputSelect>
                                </div>
                                <div class="workflow-board__field">
                                    <label class="form-label">Due date</label>
                                    <input type="date" class="form-control"
                                           value="@_createForm.DueDateString"
                                           @onchange="e => _createForm.DueDateString = e.Value?.ToString()" />
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_createError))
                            {
                                <div class="workflow-board__form-error" role="alert">@_createError</div>
                            }
                            <div class="workflow-board__form-actions">
                                <button class="btn btn-outline-secondary" type="button" @onclick="CancelCreate">Cancel</button>
                                <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
                                    @(_isSubmitting ? "Creating…" : "Create idea")
                                </button>
                            </div>
                    </EditForm>
                </aside>
            }

            @if (_swimlanes.Count == 0)
            {
                <div class="alert alert-secondary">
                    <strong>No swimlanes configured.</strong>
                    An administrator can add statuses and configure this board in
                    <a href="/settings/boards">Settings → Boards &amp; Statuses</a>.
                </div>
            }
            else
            {
                <div class="board-stage">
                <div class="board-columns">
                    @foreach (var swimlane in _swimlanes)
                    {
                        var laneIdeas = IdeasForSwimlane(swimlane.StatusId);
                        <section class="board-column">
                            <div class="board-column-header">
                                <span class="board-column-title">@swimlane.StatusName</span>
                                <span class="board-column-count">@laneIdeas.Count</span>
                            </div>

                            @if (laneIdeas.Count == 0)
                            {
                                <div class="board-card-empty">
                                    @if (HasActiveFilters)
                                    {
                                        <strong>No matching ideas</strong>
                                        <span>Try another search or filter.</span>
                                    }
                                    else
                                    {
                                        <strong>No ideas here yet</strong>
                                        <span>This lane is ready for its first idea.</span>
                                        @if (CanCreateIdea)
                                        {
                                            <button type="button" @onclick="StartCreateIdea">Add an idea</button>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                @foreach (var idea in laneIdeas)
                                {
                                    var ideaId = idea.IdeaId;
                                    <article class="board-card" tabindex="0" @onclick="() => OpenIdeaOverlay(ideaId)" @onkeydown="args => HandleCardKeyDown(args, ideaId)">
                                        <div class="board-card__body">
                                            <div class="board-card__title" title="@idea.Title">@idea.Title</div>
                                            <div class="board-card__meta">
                                                @if (!string.IsNullOrWhiteSpace(idea.Priority))
                                                {
                                                    <span class="badge @PriorityBadgeClass(idea.Priority)">@idea.Priority</span>
                                                }
                                                @if (idea.DueDate is not null)
                                                {
                                                    <span>Due @idea.DueDate.Value.ToString("MMM d")</span>
                                                }
                                                @if (idea.UpvoteCount > 0)
                                                {
                                                    <span class="board-card__votes">▲ @idea.UpvoteCount</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(idea.AssigneeDisplayName))
                                            {
                                                <div class="board-card__assignee"><span aria-hidden="true">@AssigneeInitials(idea.AssigneeDisplayName)</span>@idea.AssigneeDisplayName</div>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </section>
                    }
                </div>
                </div>
            }
        }
    </main>

    @* Idea detail overlay *@
    @if (_overlayIdeaId.HasValue)
    {
        <div class="idea-overlay-backdrop" @onclick="CloseOverlay"></div>
        <aside class="idea-overlay-panel" role="dialog" aria-modal="true" aria-labelledby="idea-detail-title" @onclick:stopPropagation="true">
            <header class="idea-overlay__header">
                <div>
                    <span>Board card</span>
                    <h2 id="idea-detail-title">Idea details</h2>
                </div>
                <div class="idea-overlay__header-actions">
                    @if (_overlayIdea is not null)
                    {
                        <a class="idea-overlay__open"
                           href="/ideas/@_overlayIdea.IdeaId/edit"
                           title="Open full edit page">Open full view</a>
                    }
                    <button class="idea-overlay__close" aria-label="Close idea details" @onclick="CloseOverlay">×</button>
                </div>
            </header>

            @if (_overlayLoading)
            {
                <div class="idea-overlay__loading">
                    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                    <span>Loading…</span>
                </div>
            }
            else if (_overlayError is not null)
            {
                <div class="alert alert-danger py-2">@_overlayError</div>
            }
            else if (_overlayIdea is not null)
            {
                <div class="idea-overlay__content">
                <h3 class="idea-overlay__title">@_overlayIdea.Title</h3>
                <div class="idea-overlay__summary">
                    <span class="idea-overlay__priority">@_overlayIdea.Priority</span>
                    @if (_overlayIdea.DueDate is not null)
                    {
                        <span>Due @_overlayIdea.DueDate.Value.ToString("MMM d, yyyy")</span>
                    }
                </div>

                <div class="idea-overlay__field">
                    <label for="idea-status">Status</label>
                    <select id="idea-status" class="form-select" value="@_overlaySelectedStatusId"
                            @onchange="OverlayHandleStatusChangeAsync" disabled="@_overlaySubmitting">
                        @foreach (var swimlane in _swimlanes)
                        {
                            <option value="@swimlane.StatusId">@swimlane.StatusName</option>
                        }
                    </select>
                </div>

                @if (!string.IsNullOrWhiteSpace(_overlayIdea.Description))
                {
                    <section class="idea-overlay__section">
                        <h4>Description</h4>
                        <p>@_overlayIdea.Description</p>
                    </section>
                }

                <div class="idea-overlay__engagement">
                    <span>▲ @_overlayIdea.UpvoteCount upvotes</span>
                    <button type="button"
                            @onclick="OverlayToggleUpvoteAsync"
                            disabled="@_overlaySubmitting">
                        @(_overlayHasUpvoted ? "Remove upvote" : "Upvote")
                    </button>
                </div>

                @if (_overlayIdea.TagNames.Count > 0)
                {
                    <section class="idea-overlay__section">
                        <h4>Tags</h4>
                        <div class="idea-overlay__tags">
                            @foreach (var tag in _overlayIdea.TagNames)
                            {
                                <span>@tag</span>
                            }
                        </div>
                    </section>
                }

                <section class="idea-overlay__comments">
                <h4>Comments <span>@_overlayIdea.Comments.Count</span></h4>
                @if (_overlayIdea.Comments.Count == 0)
                {
                    <p class="idea-overlay__comments-empty">No comments yet. Start the conversation below.</p>
                }
                else
                {
                    <div class="idea-overlay__comment-list">
                        @foreach (var comment in _overlayIdea.Comments)
                        {
                            <article class="idea-overlay__comment">
                                <time datetime="@comment.CreatedAtUtc.ToString("O")">@comment.CreatedAtUtc.ToLocalTime().ToString("MMM d · h:mm tt")</time>
                                <p>@comment.Body</p>
                            </article>
                        }
                    </div>
                }

                <EditForm Model="_overlayComment" OnValidSubmit="OverlayAddCommentAsync" class="idea-overlay__composer">
                    <DataAnnotationsValidator />
                    <div>
                        <label for="idea-comment">Add a comment</label>
                        <InputTextArea id="idea-comment" class="form-control" rows="3"
                                       placeholder="Add a comment…"
                                       @bind-Value="_overlayComment.Body" />
                        <ValidationMessage For="() => _overlayComment.Body" />
                    </div>
                    <button type="submit" disabled="@_overlaySubmitting">
                        @(_overlaySubmitting ? "Posting…" : "Post")
                    </button>
                </EditForm>
                </section>
                </div>
            }
        </aside>
    }
</AuthGate>

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    private BoardSummaryDto? _board;
    private SargentNexus.Client.Workflow.PagedResultDto<IdeaListItemDto> _ideasResult = new();
    private List<SwimlaneDto> _swimlanes = new();

    private bool _loading = true;
    private bool _isSubmitting;
    private bool _showCreateForm;
    private string _boardStyle = "jira";
    private string _ideaFilter = "all";
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _createError;
    private CreateIdeaFormModel _createForm = new();

    // Overlay state
    private Guid? _overlayIdeaId;
    private IdeaDetailDto? _overlayIdea;
    private bool _overlayLoading;
    private bool _overlaySubmitting;
    private string? _overlayError;
    private Guid _overlaySelectedStatusId;
    private bool _overlayHasUpvoted;
    private bool _boardNeedsRefresh;
    private OverlayCommentModel _overlayComment = new();

    private bool CanCreateIdea
    {
        get
        {
            var role = AuthSessionService.User?.Role ?? string.Empty;
            return string.Equals(role, "SiteAdmin", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "OrgAdmin", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "User", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_board is null || _board.BoardId != BoardId)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            if (!AuthSessionService.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            _board = await WorkflowApiClient.GetBoardDetailAsync(AuthSessionService.AccessToken!, BoardId, CancellationToken.None);
            _swimlanes = _board.Swimlanes
                .Where(s => !s.IsDeletedStatus)
                .OrderBy(s => s.Order)
                .ToList();

            _ideasResult = await WorkflowApiClient.ListIdeasAsync(AuthSessionService.AccessToken!, BoardId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool HasActiveFilters => _ideaFilter != "all" || !string.IsNullOrWhiteSpace(_searchText);

    private int VisibleIdeaCount => _ideasResult.Items.Count(MatchesActiveFilters);

    private List<IdeaListItemDto> IdeasForSwimlane(Guid statusId) =>
        _ideasResult.Items.Where(idea => idea.StatusId == statusId && MatchesActiveFilters(idea)).ToList();

    private bool MatchesActiveFilters(IdeaListItemDto idea)
    {
        var currentUserId = AuthSessionService.User?.UserId;
        var matchesPersonalFilter = _ideaFilter switch
        {
            "created" => currentUserId.HasValue && idea.AuthorUserId == currentUserId.Value,
            "assigned" => currentUserId.HasValue && idea.AssigneeUserId == currentUserId.Value,
            _ => true
        };

        if (!matchesPersonalFilter || string.IsNullOrWhiteSpace(_searchText))
        {
            return matchesPersonalFilter;
        }

        var searchText = _searchText.Trim();
        return idea.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || (idea.AssigneeDisplayName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            || (idea.AuthorDisplayName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void ShowAllIdeas() => _ideaFilter = "all";

    private void ShowCreatedIdeas() => _ideaFilter = "created";

    private void ShowAssignedIdeas() => _ideaFilter = "assigned";

    private string FilterButtonClass(string filter) =>
        _ideaFilter == filter ? "board-filter-picker__button is-active" : "board-filter-picker__button";

    private void SetJiraStyle() => _boardStyle = "jira";

    private void SetTrelloStyle() => _boardStyle = "trello";

    private void SetFocusStyle() => _boardStyle = "focus";

    private string StyleButtonClass(string style) =>
        _boardStyle == style ? "board-style-picker__button is-active" : "board-style-picker__button";

    private static string AssigneeInitials(string displayName) =>
        string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private async Task HandleCardKeyDown(KeyboardEventArgs args, Guid ideaId)
    {
        if (args.Key is "Enter" or " ")
        {
            await OpenIdeaOverlay(ideaId);
        }
    }

    private async Task OpenIdeaOverlay(Guid ideaId)
    {
        _overlayIdeaId = ideaId;
        _overlayIdea = null;
        _overlayLoading = true;
        _overlayError = null;
        _overlayComment = new OverlayCommentModel();
        _boardNeedsRefresh = false;

        try
        {
            _overlayIdea = await WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, ideaId, CancellationToken.None);
            _overlaySelectedStatusId = _overlayIdea.StatusId;
            _overlayHasUpvoted = false;
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _overlayLoading = false;
        }
    }

    private async Task CloseOverlay()
    {
        _overlayIdeaId = null;
        _overlayIdea = null;

        if (_boardNeedsRefresh)
        {
            await LoadAsync();
        }
    }

    private async Task OverlayHandleStatusChangeAsync(ChangeEventArgs args)
    {
        if (_overlayIdea is null || !Guid.TryParse(args.Value?.ToString(), out var statusId))
        {
            return;
        }

        _overlaySubmitting = true;
        try
        {
            await WorkflowApiClient.MoveIdeaStatusAsync(AuthSessionService.AccessToken!, _overlayIdea.IdeaId, statusId, CancellationToken.None);
            _overlaySelectedStatusId = statusId;
            _overlayIdea.StatusId = statusId;
            _overlayIdea.StatusName = _swimlanes.FirstOrDefault(x => x.StatusId == statusId)?.StatusName ?? _overlayIdea.StatusName;
            _boardNeedsRefresh = true;
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _overlaySubmitting = false;
        }
    }

    private async Task OverlayToggleUpvoteAsync()
    {
        if (_overlayIdea is null)
        {
            return;
        }

        _overlaySubmitting = true;
        try
        {
            var result = await WorkflowApiClient.ToggleUpvoteAsync(AuthSessionService.AccessToken!, _overlayIdea.IdeaId, CancellationToken.None);
            _overlayHasUpvoted = result.HasUpvoted;
            _overlayIdea.UpvoteCount = result.UpvoteCount;
            _boardNeedsRefresh = true;
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _overlaySubmitting = false;
        }
    }

    private async Task OverlayAddCommentAsync()
    {
        if (_overlayIdea is null)
        {
            return;
        }

        _overlaySubmitting = true;
        try
        {
            await WorkflowApiClient.CreateCommentAsync(
                AuthSessionService.AccessToken!,
                _overlayIdea.IdeaId,
                new CommentWriteRequestDto { Body = _overlayComment.Body.Trim() },
                CancellationToken.None);

            _overlayComment = new OverlayCommentModel();
            // Reload overlay data to show new comment
            _overlayIdea = await WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, _overlayIdea.IdeaId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _overlayError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _overlaySubmitting = false;
        }
    }

    private void StartCreateIdea()
    {
        _createForm = new CreateIdeaFormModel();
        _createError = null;
        _showCreateForm = true;
    }

    private void CancelCreate()
    {
        _showCreateForm = false;
        _createError = null;
    }

    private async Task SaveNewIdeaAsync()
    {
        _isSubmitting = true;
        _createError = null;

        try
        {
            DateOnly? dueDate = null;
            if (!string.IsNullOrWhiteSpace(_createForm.DueDateString)
                && DateOnly.TryParse(_createForm.DueDateString, out var parsed))
            {
                dueDate = parsed;
            }

            await WorkflowApiClient.CreateIdeaAsync(
                AuthSessionService.AccessToken!,
                BoardId,
                new IdeaWriteRequestDto
                {
                    Title = _createForm.Title.Trim(),
                    Description = _createForm.Description?.Trim() ?? string.Empty,
                    Priority = _createForm.Priority ?? string.Empty,
                    DueDate = dueDate
                },
                CancellationToken.None);

            _showCreateForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _createError = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string PriorityBadgeClass(string priority) => priority.ToLowerInvariant() switch
    {
        "critical" => "text-bg-danger",
        "high"     => "text-bg-warning",
        "medium"   => "text-bg-primary",
        "low"      => "text-bg-secondary",
        _          => "text-bg-light"
    };

    private sealed class CreateIdeaFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(200)]
        public string Title { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public string? Priority { get; set; }

        public string? DueDateString { get; set; }
    }

    private sealed class OverlayCommentModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(2000)]
        public string Body { get; set; } = string.Empty;
    }
}
