@page "/ideas"
@page "/ideas/{IdeaId:guid}"
@page "/ideas/{IdeaId:guid}/edit"
@inject IAuthSessionService AuthSessionService
@inject IClientErrorMessageService ErrorMessageService
@inject NavigationManager NavigationManager
@inject WorkflowApiClient WorkflowApiClient

<PageTitle>@PageTitleText</PageTitle>

<AuthGate>
    @if (IsListView)
    {
        <div class="container py-4 sn-page sn-ideas-page">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                <div>
                    <h1 class="h3 mb-1">Ideas</h1>
                    <p class="text-muted mb-0">Combined ideas created by you or assigned to you.</p>
                </div>
            </div>

            @if (_listLoading)
            {
                <div class="d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                    <span>Loading ideas...</span>
                </div>
            }
            else if (_listErrorMessage is not null)
            {
                <div class="alert alert-danger">@_listErrorMessage</div>
            }
            else if (_listItems.Count == 0)
            {
                <div class="alert alert-secondary">No ideas matched your filters.</div>
            }
            else
            {
                <SearchPaginationBar @bind-SearchText="_search"
                                     @bind-PageSize="_pageSize"
                                     OnSearch="HandleSearchAsync" />

                <div class="btn-group mb-3" role="group" aria-label="Idea filters">
                    <button class="@GetFilterButtonClass(IdeaFilterAll)" @onclick="() => SetFilterAsync(IdeaFilterAll)">All</button>
                    <button class="@GetFilterButtonClass(IdeaFilterCreatedByMe)" @onclick="() => SetFilterAsync(IdeaFilterCreatedByMe)">Created by me</button>
                    <button class="@GetFilterButtonClass(IdeaFilterAssignedToMe)" @onclick="() => SetFilterAsync(IdeaFilterAssignedToMe)">Assigned to me</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Created By</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _listItems)
                            {
                                <tr>
                                    <td>
                                        <NavLink class="fw-semibold text-decoration-none" href="@GetIdeaEditUrl(item.IdeaId)">
                                            @item.Title
                                        </NavLink>
                                    </td>
                                    <td>@(item.AuthorDisplayName ?? "-")</td>
                                    <td>@(item.AssigneeDisplayName ?? "-")</td>
                                    <td>@item.StatusName</td>
                                    <td>@item.CreatedAtUtc.ToLocalTime().ToString("d")</td>
                                    <td class="text-end">
                                        <NavLink class="btn btn-sm btn-outline-primary" href="@GetIdeaEditUrl(item.IdeaId)">Details</NavLink>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                    <span class="text-muted small">@GetResultSummary()</span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPageAsync" disabled="@(_page <= 1)">Prev</button>
                        <span class="align-self-center small">Page @_page</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(_page * _pageSize >= _totalCount)">Next</button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
    <div class="container py-4">
        <div class="d-flex gap-2 mb-3">
            <a class="btn btn-outline-secondary btn-sm" href="/ideas">← My Ideas</a>
            <a class="btn btn-outline-secondary btn-sm" href="/board">← Boards</a>
        </div>

        @if (_loading)
        {
            <div class="alert alert-info">Loading idea…</div>
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        else if (_idea is null)
        {
            <div class="alert alert-warning">The requested idea could not be found.</div>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h1 class="h3 mb-2">@_idea.Title</h1>
                            <div class="text-muted">Priority: @_idea.Priority • Status: @_idea.StatusName</div>
                            @if (_idea.DueDate is not null)
                            {
                                <div class="text-muted">Due: @_idea.DueDate.Value.ToString("d")</div>
                            }
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2">
                            <span class="badge text-bg-primary">@_idea.UpvoteCount upvotes</span>
                            <button class="btn btn-outline-primary btn-sm" @onclick="HandleToggleUpvoteAsync" disabled="@_isSubmitting">@(_hasUpvoted ? "Remove upvote" : "Upvote")</button>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select class="form-select" value="@_selectedStatusId" @onchange="HandleStatusChangeAsync">
                                @foreach (var swimlane in _boardSwimlanes)
                                {
                                    <option value="@swimlane.StatusId">@swimlane.StatusName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <p class="mb-4">@_idea.Description</p>

                    @if (_idea.TagNames.Count > 0)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">Tags</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in _idea.TagNames)
                                {
                                    <span class="badge text-bg-light">@tag</span>
                                }
                            </div>
                        </div>
                    }

                    @if (_idea.Mentions.Count > 0)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">Mentions</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mention in _idea.Mentions)
                                {
                                    <span class="badge text-bg-secondary">@mention</span>
                                }
                            </div>
                        </div>
                    }

                    <hr />

                    <h2 class="h6 mb-3">Comments</h2>
                    @if (_idea.Comments.Count == 0)
                    {
                        <p class="text-muted mb-3">No comments yet.</p>
                    }
                    else
                    {
                        <div class="list-group mb-3">
                            @foreach (var comment in _idea.Comments)
                            {
                                <div class="list-group-item">
                                    <div class="fw-semibold">Comment</div>
                                    <div class="small text-muted">@comment.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                                    <div class="mt-2">@comment.Body</div>
                                </div>
                            }
                        </div>
                    }

                    <EditForm Model="_commentModel" OnValidSubmit="HandleCommentAsync">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Add a comment</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_commentModel.Body" />
                            <ValidationMessage For="() => _commentModel.Body" />
                        </div>
                        <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">@(_isSubmitting ? "Posting..." : "Post comment")</button>
                    </EditForm>
                </div>
            </div>
        }
    </div>
    }
</AuthGate>

@code {
    [Parameter]
    public Guid? IdeaId { get; set; }

    private const string IdeaFilterAll = "all";
    private const string IdeaFilterCreatedByMe = "createdByMe";
    private const string IdeaFilterAssignedToMe = "assignedToMe";

    private readonly List<IdeaListItemDto> _listItems = new();
    private IdeaDetailDto? _idea;
    private bool _loading = true;
    private bool _listLoading = true;
    private bool _isSubmitting;
    private bool _hasUpvoted;
    private string? _errorMessage;
    private string? _listErrorMessage;
    private Guid _selectedStatusId;
    private List<SwimlaneDto> _boardSwimlanes = new();
    private CommentFormModel _commentModel = new();
    private string _search = string.Empty;
    private string _filter = IdeaFilterAll;
    private int _page = 1;
    private int _pageSize = 25;
    private int _totalCount;

    private bool IsListView => !IdeaId.HasValue;

    private string PageTitleText => IsListView ? "Ideas" : "Idea details";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (IsListView)
        {
            await LoadIdeasAsync();
            return;
        }

        _loading = true;
        _errorMessage = null;

        try
        {
            _idea = await WorkflowApiClient.GetIdeaDetailAsync(AuthSessionService.AccessToken!, IdeaId!.Value, CancellationToken.None);

            var board = await WorkflowApiClient.GetBoardDetailAsync(AuthSessionService.AccessToken!, _idea.BoardId, CancellationToken.None);
            _boardSwimlanes = board.Swimlanes.ToList();
            _selectedStatusId = _idea.StatusId;
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadIdeasAsync()
    {
        _listLoading = true;
        _listErrorMessage = null;

        try
        {
            if (!AuthSessionService.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var organizationId = AuthSessionService.User?.OrganizationId;
            if (organizationId is null || organizationId.Value == Guid.Empty)
            {
                _listItems.Clear();
                _totalCount = 0;
                return;
            }

            var accessToken = AuthSessionService.AccessToken
                ?? throw new InvalidOperationException("Missing access token for authenticated session.");

            var result = await WorkflowApiClient.ListMyIdeasAsync(
                accessToken,
                organizationId.Value,
                _page,
                _pageSize,
                _search,
                _filter,
                CancellationToken.None);

            _listItems.Clear();
            _listItems.AddRange(result.Items);
            _totalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            _listErrorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _listLoading = false;
        }
    }

    private async Task HandleSearchAsync()
    {
        _page = 1;
        await LoadIdeasAsync();
    }

    private async Task SetFilterAsync(string filter)
    {
        if (string.Equals(_filter, filter, StringComparison.Ordinal))
        {
            return;
        }

        _filter = filter;
        _page = 1;
        await LoadIdeasAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_page <= 1)
        {
            return;
        }

        _page--;
        await LoadIdeasAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page * _pageSize >= _totalCount)
        {
            return;
        }

        _page++;
        await LoadIdeasAsync();
    }

    private string GetFilterButtonClass(string filter)
    {
        return string.Equals(_filter, filter, StringComparison.Ordinal)
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }

    private string GetIdeaEditUrl(Guid ideaId) => $"/ideas/{ideaId}/edit";

    private string GetResultSummary()
    {
        if (_totalCount == 0)
        {
            return "Showing 0 of 0";
        }

        var start = (_page - 1) * _pageSize + 1;
        var end = Math.Min(_page * _pageSize, _totalCount);
        return $"Showing {start}-{end} of {_totalCount}";
    }

    private async Task HandleCommentAsync()
    {
        if (_idea is null)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            await WorkflowApiClient.CreateCommentAsync(AuthSessionService.AccessToken!, _idea.IdeaId, new CommentWriteRequestDto
            {
                Body = _commentModel.Body.Trim()
            }, CancellationToken.None);

            _commentModel = new CommentFormModel();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleToggleUpvoteAsync()
    {
        if (_idea is null)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await WorkflowApiClient.ToggleUpvoteAsync(AuthSessionService.AccessToken!, _idea.IdeaId, CancellationToken.None);
            _hasUpvoted = result.HasUpvoted;
            _idea.UpvoteCount = result.UpvoteCount;
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleStatusChangeAsync(ChangeEventArgs args)
    {
        if (_idea is null || !Guid.TryParse(args.Value?.ToString(), out var statusId))
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            await WorkflowApiClient.MoveIdeaStatusAsync(AuthSessionService.AccessToken!, _idea.IdeaId, statusId, CancellationToken.None);
            _selectedStatusId = statusId;
            _idea.StatusId = statusId;
            _idea.StatusName = _boardSwimlanes.FirstOrDefault(x => x.StatusId == statusId)?.StatusName ?? _idea.StatusName;
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class CommentFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(2000)]
        public string Body { get; set; } = string.Empty;
    }
}
