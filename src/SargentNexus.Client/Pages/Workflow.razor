@page "/boards"
@inject IAuthSessionService AuthSessionService
@inject IClientErrorMessageService ErrorMessageService
@inject NavigationManager NavigationManager
@inject WorkflowApiClient WorkflowApiClient

<PageTitle>Boards</PageTitle>

<AuthGate>
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <h1 class="h3 mb-0">Boards</h1>
            @if (CanCreateBoard)
            {
                <button class="btn btn-primary" type="button" aria-label="Add new board" @onclick="StartCreateBoard">Add New</button>
            }
        </div>

        @if (_loading)
        {
            <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                <span>Loading…</span>
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        else if (_boards.Count == 0)
        {
            <p class="text-muted">No boards have been created for your organization yet.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Board Type</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var board in _boards)
                    {
                        <tr>
                            <td>@board.Name</td>
                            <td>@(board.AllowUserStatusUpdate ? "User-managed" : "Admin-managed")</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenBoard(board.BoardId)">Open</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</AuthGate>

@code {
    private readonly List<BoardSummaryDto> _boards = new();
    private bool _loading = true;
    private string? _errorMessage;

    private bool CanCreateBoard =>
        string.Equals(AuthSessionService.User?.Role, "SiteAdmin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSessionService.User?.Role, "OrgAdmin", StringComparison.OrdinalIgnoreCase);

    private void OpenBoard(Guid boardId) => NavigationManager.NavigateTo($"/board/{boardId}");

    private void StartCreateBoard() => NavigationManager.NavigateTo("/settings/boards?create=true");

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            if (!AuthSessionService.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var organizationId = AuthSessionService.User?.OrganizationId;
            if (organizationId is null || organizationId.Value == Guid.Empty)
            {
                _errorMessage = "Your account is not associated with an organization yet.";
                return;
            }

            var boards = await WorkflowApiClient.ListBoardsAsync(AuthSessionService.AccessToken!, organizationId.Value, CancellationToken.None);
            _boards.Clear();
            _boards.AddRange(boards);
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorMessageService.GetDisplayMessage(null, null, ex);
        }
        finally
        {
            _loading = false;
        }
    }
}

